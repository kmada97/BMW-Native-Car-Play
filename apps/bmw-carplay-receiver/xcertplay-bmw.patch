+package com.shilapi.xcertplay.bmw
+
+/** One replaceable value, with a generation to reject work finishing after reset/stop. */
+internal class LatestFrameSlot<T> {
+    private var generation = 0L
+    private var value: T? = null
+    @Synchronized fun token(): Long = generation
+    @Synchronized fun publish(token: Long, next: T): Boolean {
+        if (token != generation) return false
+        value = next
+        return true
+    }
+    @Synchronized fun latest(): T? = value
+    @Synchronized fun reset(): Long { value = null; return ++generation }
+}
+
+internal object BmwVideoGeometry {
+    private val selected = BmwDisplayLayout.selectedWideId4Profile()
+    val WIDTH = selected.canvasWidth
+    val HEIGHT = selected.canvasHeight
+    val SOURCE_WIDTH = selected.sourceWidth
+    val SOURCE_HEIGHT = selected.sourceHeight
+    // AirPlay primaryInputDevice enumeration: undeclared0, touch1, touchpad2, knobs3.
+    const val KNOB_INPUT = 3
+    fun valid(width: Int, height: Int) = width in 200..2048 && height in 200..1024
+}
+
+/** Used only on JPEG worker; unchanged decoded pictures need no additional BMW transfer. */
+internal class ChangedJpegGate {
+    private var generation=Long.MIN_VALUE
+    private var width=0
+    private var height=0
+    private var previous:ByteArray?=null
+    fun accept(generation:Long,width:Int,height:Int,jpeg:ByteArray):Boolean {
+        if(this.generation==generation&&this.width==width&&this.height==height&&previous?.contentEquals(jpeg)==true)return false
+        this.generation=generation;this.width=width;this.height=height;previous=jpeg
+        return true
+    }
+}

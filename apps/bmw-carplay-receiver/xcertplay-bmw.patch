@@ -0,0 +1,85 @@
+package com.shilapi.xcertplay.bmw
+
+import android.content.Context
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import com.shilapi.xcertplay.airplay.VideoCodec
+import com.shilapi.xcertplay.media.AndroidMediaSink
+import java.io.ByteArrayOutputStream
+import java.io.Closeable
+import java.nio.ByteBuffer
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** One15minute local AVC playback through exactly the receiver decoder/capture path. No auth/audio. */
+internal class BmwDecoderTest(private val context:Context):Closeable {
+    private val stopped=AtomicBoolean(false)
+    @Volatile private var sink:AndroidMediaSink?=null
+    @Volatile private var session:BmwBridge.CaptureSession?=null
+    private val thread=Thread(::run,"bmw-local-avc-test")
+    fun start() { thread.start() }
+    private fun run() {
+        val extractor=MediaExtractor()
+        var failure:String?=null
+        try {
+            // Android may compress packaged assets; copy only our own tiny fixture to private cache.
+            val fixture=java.io.File(context.cacheDir,"bmw-decoder-test.mp4")
+            context.assets.open("bmw-decoder-test.mp4").use { input -> fixture.outputStream().use { input.copyTo(it) } }
+            extractor.setDataSource(fixture.absolutePath)
+            val track=(0 until extractor.trackCount).first { extractor.getTrackFormat(it).getString(MediaFormat.KEY_MIME)=="video/avc" }
+            extractor.selectTrack(track)
+            val format=extractor.getTrackFormat(track)
+            val w=format.getInteger(MediaFormat.KEY_WIDTH);val h=format.getInteger(MediaFormat.KEY_HEIGHT)
+            if(stopped.get())return
+            val capture=BmwBridge.newTestSession(this,w,h);session=capture
+            val renderer=AndroidMediaSink(context,videoWidth=w,videoHeight=h,
+                onScreenStreamActiveChanged={ type,active -> capture.onStreamActive(type,active) },onClosed={capture.close()})
+            sink=renderer
+            if(stopped.get() || !capture.bind(renderer))return
+            renderer.onVideoCodec(BmwBridge.MAIN,VideoCodec.H264)
+            val sps=rawNal(checkNotNull(format.getByteBuffer("csd-0")))
+            val pps=rawNal(checkNotNull(format.getByteBuffer("csd-1")))
+            val config=avcConfig(sps,pps)
+            renderer.onVideoConfig(BmwBridge.MAIN,config)
+            renderer.onScreenStreamActive(BmwBridge.MAIN,true)
+            val buffer=ByteBuffer.allocate(2*1024*1024)
+            val until=System.nanoTime()+900_000_000_000L
+            var start=System.nanoTime()
+            while(!stopped.get()&&System.nanoTime()<until) {
+                buffer.clear()
+                val count=extractor.readSampleData(buffer,0)
+                if(count<0) { extractor.seekTo(0,MediaExtractor.SEEK_TO_CLOSEST_SYNC);start=System.nanoTime();continue }
+                val due=start+extractor.sampleTime*1000L
+                while(!stopped.get()&&System.nanoTime()<due) Thread.sleep(minOf(20L,(due-System.nanoTime())/1_000_000L+1))
+                if(stopped.get())break
+                val bytes=ByteArray(count);buffer.position(0);buffer.get(bytes)
+                renderer.onVideoFrame(BmwBridge.MAIN,bytes)
+                extractor.advance()
+            }
+        } catch (error:Exception) {
+            if(!stopped.get())failure=error.message ?: error.javaClass.simpleName
+        } finally {
+            extractor.release();sink?.close();sink=null;session?.close();session=null
+            BmwBridge.finishDecoderTest(this,failure)
+        }
+    }
+    override fun close() {
+        if(!stopped.compareAndSet(false,true))return
+        thread.interrupt()
+        // Worker performs MediaCodec shutdown; caller/UI never waits for decoder threads.
+        session?.onStreamActive(BmwBridge.MAIN,false)
+    }
+    private fun rawNal(buffer:ByteBuffer):ByteArray {
+        val copy=buffer.duplicate();val bytes=ByteArray(copy.remaining());copy.get(bytes)
+        val offset=if(bytes.size>=4&&bytes[0]==0.toByte()&&bytes[1]==0.toByte()&&bytes[2]==0.toByte()&&bytes[3]==1.toByte())4
+            else if(bytes.size>=3&&bytes[0]==0.toByte()&&bytes[1]==0.toByte()&&bytes[2]==1.toByte())3 else 0
+        return bytes.copyOfRange(offset,bytes.size)
+    }
+    private fun avcConfig(sps:ByteArray,pps:ByteArray):ByteArray {
+        require(sps.size>=4&&sps.size<=65535&&pps.isNotEmpty()&&pps.size<=65535)
+        return ByteArrayOutputStream().apply {
+            write(byteArrayOf(1,sps[1],sps[2],sps[3],0xff.toByte(),0xe1.toByte()))
+            write(sps.size ushr 8);write(sps.size and 255);write(sps)
+            write(1);write(pps.size ushr 8);write(pps.size and 255);write(pps)
+        }.toByteArray()
+    }
+}

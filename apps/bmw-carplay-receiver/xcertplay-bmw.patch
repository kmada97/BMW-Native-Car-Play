+package com.shilapi.xcertplay.bmw
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ForegroundLaunchGateTest {
+    @Test fun creationAloneCannotNavigateOverAnIncomingUsbActivity() {
+        val gate = ForegroundLaunchGate()
+        gate.request()
+        assertFalse(gate.consume())
+        gate.resume()
+        assertFalse(gate.consume())
+        gate.focus(true)
+        assertTrue(gate.consume())
+        assertFalse(gate.consume())
+    }
+
+    @Test fun usbLaunchPausesAndInvalidatesAlreadyQueuedNavigation() {
+        val gate = ForegroundLaunchGate()
+        gate.request(); gate.resume(); gate.focus(true)
+        // The Handler task was posted, but the system USB activity wins foreground first.
+        gate.pause()
+        assertFalse(gate.consume())
+        gate.resume()
+        assertFalse(gate.consume()) // old window focus cannot be reused
+        gate.focus(true)
+        assertTrue(gate.consume())
+    }
+
+    @Test fun focusLossBeforePauseAlsoPreventsNavigation() {
+        val gate = ForegroundLaunchGate()
+        gate.request(); gate.resume(); gate.focus(true)
+        gate.focus(false)
+        assertFalse(gate.consume())
+        gate.focus(true)
+        assertTrue(gate.consume())
+    }
+
+    @Test fun newHomeIntentWhilePausedWaitsForActualForeground() {
+        val gate = ForegroundLaunchGate()
+        gate.resume(); gate.focus(true); gate.request()
+        assertTrue(gate.consume())
+        gate.pause(); gate.request(); gate.request()
+        assertFalse(gate.consume())
+        gate.resume(); gate.focus(true)
+        assertTrue(gate.consume())
+        assertFalse(gate.consume())
+    }
+
+    @Test fun checkpointChainCannotUndoHomeYieldToUsbActivity() {
+        val home = ForegroundLaunchGate()
+        home.request(); home.resume(); home.focus(true)
+        assertTrue(home.consume())
+        val checkpoint = ForegroundLaunchGate()
+        checkpoint.request()
+        checkpoint.resume(); checkpoint.focus(true)
+        checkpoint.pause() // My BMW starts before the queued host launch
+        assertFalse(checkpoint.consume())
+        checkpoint.resume(); checkpoint.focus(true) // My BMW completes and yields
+        assertTrue(checkpoint.consume())
+    }
+
+    @Test fun destructionRejectsLateCallbackAndNewRequest() {
+        val gate = ForegroundLaunchGate()
+        gate.request(); gate.resume(); gate.focus(true); gate.close()
+        gate.request(); gate.resume(); gate.focus(true)
+        assertFalse(gate.consume())
+    }
+
+    @Test fun selectedHomeReceivesOnlySystemLaunchNotSecondBootLaunch() {
+        assertFalse(BmwBootPolicy.shouldLaunch(true, "receiver", "receiver"))
+    }
+
+    @Test fun disabledAutostartNeverCreatesBootLaunch() {
+        assertFalse(BmwBootPolicy.shouldLaunch(false, "receiver", "receiver"))

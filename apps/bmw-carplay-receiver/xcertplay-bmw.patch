@@ -0,0 +1,32 @@
+package com.shilapi.xcertplay.bmw
+
+import com.shilapi.xcertplay.airplay.AirPlayDisplayConfig
+import com.shilapi.xcertplay.airplay.AirPlayDisplaySettings
+import kotlin.math.roundToInt
+
+/** BMW projection must not inherit the HDMI monitor's physical aspect or view areas. */
+internal object BmwAirPlayGeometry {
+    /**
+     * 200 mm is the receiver's logical reference width, not a measured BMW panel size.
+     * Apply one uniform pixel density to both axes. Leaving HDMI's old heightPhysicalMm
+     * here advertised 1088x400 pixels inside a 16:9 physical rectangle and distorted UI.
+     */
+    fun mainDisplay(base: AirPlayDisplayConfig, width: Int, height: Int): AirPlayDisplayConfig {
+        require(width in 200..2048 && height in 200..1024) { "Unsupported BMW source geometry" }
+        val referenceWidth = AirPlayDisplaySettings.DEFAULT_WIDTH_PHYSICAL_MM
+        val physicalHeight = (referenceWidth * height.toDouble() / width).roundToInt().coerceAtLeast(1)
+        return base.copy(
+            widthPixels = width,
+            heightPixels = height,
+            widthPhysicalMm = referenceWidth,
+            heightPhysicalMm = physicalHeight,
+            fps = 15,
+            primaryInputDevice = 3,
+            viewArea = null,
+            safeArea = null,
+            safeAreaDrawOutside = false,
+            viewAreas = emptyList(),
+            initialViewArea = 0,
+        )
+    }
+}

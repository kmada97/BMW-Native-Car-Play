+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwArmLatch.java
@@ -0,0 +1,28 @@
+package com.shilapi.xcertplay.bmw;
+
+/** Persistent LIVE permission; bounded local tests consume a single connection attempt. */
+final class BmwArmLatch {
+    interface Store {
+        boolean armed();
+        boolean live();
+        void save(boolean armed, boolean live);
+    }
+    static final class Request {
+        final boolean live;
+        private final long generation;
+        Request(boolean live,long generation){this.live=live;this.generation=generation;}
+    }
+    private final Store store;
+    private long generation;
+    BmwArmLatch(Store store){this.store=store;}
+    synchronized void arm(boolean live){generation++;store.save(true,live);}
+    synchronized void stop(){generation++;store.save(false,store.live());}
+    synchronized Boolean pendingMode(){return store.armed()?store.live():null;}
+    synchronized Request claim(){
+        if(!store.armed())return null;
+        boolean live=store.live();
+        if(!live)store.save(false,false);
+        return new Request(live,generation);
+    }
+    synchronized boolean isCurrent(Request request){return request.generation==generation;}
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSender.java b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSender.java
new file mode 100644
index 0000000..50165a3
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSender.java
@@ -0,0 +1,105 @@
+package com.shilapi.xcertplay.bmw;
+
+import java.io.Closeable;
+import java.io.IOException;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.LongSupplier;
+import org.apache.etch.bindings.java.support.Mailbox;
+
+/** One image response in flight; the control worker never waits for its response. */
+public final class BmwAsyncImageSender implements Closeable {
+    public interface Calls {
+        Mailbox begin(byte[] image) throws Exception;
+        void end(Mailbox mailbox) throws Exception;
+    }
+    public interface Completion { void complete(Result result); }
+    public static final class Result {
+        public final long startedNs,beginFinishedNs,responseNs,handledNs;
+        public final Throwable error;
+        Result(long started,long begun,long response,long handled,Throwable error){
+            this.startedNs=started;this.beginFinishedNs=begun;this.responseNs=response;this.handledNs=handled;this.error=error;
+        }
+    }
+    private final Calls calls;
+    private final BmwProbeGuard guard;
+    private final ScheduledExecutorService timers;
+    private final Executor worker;
+    private final LongSupplier clock;
+    private Flight flight;
+    private boolean closed;
+    private final class Flight {
+        final long started=clock.getAsLong();
+        final Completion completion;
+        final AtomicBoolean queued=new AtomicBoolean();
+        volatile long beginFinished;
+        volatile Mailbox mailbox;
+        volatile ScheduledFuture<?> timeout;
+        final Mailbox.Notify notify=(box,state,isClosed)->{
+            if(box.isFull()||isClosed||box.isClosed())queue(this,null);
+        };
+        Flight(Completion completion){this.completion=completion;}
+    }
+    public BmwAsyncImageSender(Calls calls,BmwProbeGuard guard,ScheduledExecutorService timers,Executor worker,LongSupplier clock){
+        this.calls=calls;this.guard=guard;this.timers=timers;this.worker=worker;this.clock=clock;
+    }
+    public synchronized boolean busy(){return flight!=null;}
+    public boolean send(byte[] bytes,Completion completion){
+        final Flight current;
+        synchronized(this){
+            if(closed||flight!=null||guard.isCancelled())return false;
+            current=new Flight(completion);flight=current;
+        }
+        current.timeout=timers.schedule(()->{
+            if(owns(current)){
+                guard.cancel("image_rpc_timeout");
+                queue(current,new TimeoutException("BMW image response deadline"));
+            }
+        },8000,TimeUnit.MILLISECONDS);
+        try {
+            // _begin includes packet serialization and socket write, but not the response wait.
+            current.mailbox=guard.call("image_begin",8000,()->calls.begin(bytes));
+            current.beginFinished=clock.getAsLong();
+            if(!owns(current)){cleanup(current);return true;}
+            // May invoke notify inline if the peer already responded. Flight was published first.
+            current.mailbox.registerNotify(current.notify,current,0);
+        } catch(Throwable error){current.beginFinished=clock.getAsLong();queue(current,error);}
+        return true;
+    }
+    private synchronized boolean owns(Flight current){return !closed&&flight==current;}
+    private void queue(Flight current,Throwable error){
+        if(!owns(current)||!current.queued.compareAndSet(false,true))return;
+        final long response=clock.getAsLong();
+        // Receipt has happened; worker scheduling must not falsely trigger a reply timeout.
+        ScheduledFuture<?> deadline=current.timeout;if(deadline!=null)deadline.cancel(false);
+        try{worker.execute(()->finish(current,error,response));}
+        catch(RejectedExecutionException rejected){guard.cancel("image_completion_worker_stopped");close();}
+    }
+    private void finish(Flight current,Throwable error,long response){
+        if(!owns(current)){cleanup(current);return;}
+        Throwable failure=error;
+        try {
+            Mailbox mailbox=current.mailbox;
+            if(mailbox!=null)mailbox.unregisterNotify(current.notify);
+            if(failure==null){
+                if(mailbox==null||(!mailbox.isFull()&&!mailbox.isClosed()))throw new IOException("Image response was not ready");
+                // Sole reader, ready/closed mailbox: _end validates the peer response and closes read.
+                calls.end(mailbox);
+            }
+        } catch(Throwable resultError){failure=resultError;}
+        finally{cleanup(current);}
+        synchronized(this){if(closed||flight!=current)return;flight=null;}
+        if(failure!=null)guard.cancel("image_transfer_error");
+        current.completion.complete(new Result(current.started,current.beginFinished,response,clock.getAsLong(),failure));
+    }
+    private void cleanup(Flight current){
+        ScheduledFuture<?> deadline=current.timeout;if(deadline!=null)deadline.cancel(false);
+        Mailbox mailbox=current.mailbox;
+        if(mailbox!=null){mailbox.unregisterNotify(current.notify);mailbox.closeDelivery();}
+    }
+    @Override public void close(){
+        final Flight old;
+        synchronized(this){closed=true;old=flight;flight=null;}
+        if(old!=null)cleanup(old);
+    }
+}

+package com.shilapi.xcertplay.bmw
+
+import com.shilapi.xcertplay.airplay.AirPlayConfig
+import com.shilapi.xcertplay.airplay.AirPlayDisplayConfig
+import com.shilapi.xcertplay.airplay.AirPlayInfoPlist
+import com.shilapi.xcertplay.airplay.AirPlayInsets
+import com.shilapi.xcertplay.airplay.AirPlayViewArea
+import org.junit.Assert.*
+import org.junit.Test
+
+class BmwAirPlayGeometryTest {
+    private fun info(display: AirPlayDisplayConfig): Map<*, *> {
+        val config = AirPlayConfig("test", "02:00:00:00:00:02", "02:00:00:00:00:02", "366.0", display)
+        return (AirPlayInfoPlist.build(config)["displays"] as List<*>).single() as Map<*, *>
+    }
+
+    @Test fun hdmiPhysicalAspectCannotDistortWiderCarProjection() {
+        val hdmi = AirPlayDisplayConfig(1920, 1080, widthPhysicalMm = 200, heightPhysicalMm = 113)
+        val layout = BmwDisplayLayout.selectedWideId4Profile()
+        val projected = BmwAirPlayGeometry.mainDisplay(hdmi, layout.sourceWidth, layout.sourceHeight)
+        val advertised = info(projected)
+        assertEquals(1008, advertised["widthPixels"])
+        assertEquals(400, advertised["heightPixels"])
+        assertEquals(200, advertised["widthPhysical"])
+        assertEquals(79, advertised["heightPhysical"])
+        // Only integer-mm rounding remains, rather than the previous ~1.5x distortion.
+        val idealHeight = 200.0 * layout.sourceHeight / layout.sourceWidth
+        assertEquals(idealHeight, projected.heightPhysicalMm!!.toDouble(), 0.5)
+        assertEquals(113, hdmi.heightPhysicalMm) // Source settings remain unchanged.
+    }
+
+    @Test fun geometryIsIndependentOfHdmiOrientationAndPhysicalSize() {
+        val landscape = AirPlayDisplayConfig(1920, 1080, 900, 500)
+        val portrait = AirPlayDisplayConfig(1080, 1920, 80, 142)
+        val a = BmwAirPlayGeometry.mainDisplay(landscape, 1008, 400)
+        val b = BmwAirPlayGeometry.mainDisplay(portrait, 1008, 400)
+        assertEquals(a, b)
+        val narrow = BmwAirPlayGeometry.mainDisplay(landscape, 528, 400)
+        assertEquals(200.0 * 400 / 528, narrow.heightPhysicalMm!!.toDouble(), 0.5)
+    }
+
+    @Test fun staleHdmiSafeAreasAndViewAreaEnvelopeCannotCropPhoneContent() {
+        val base = AirPlayDisplayConfig(1920, 1080, 200, 113,
+            viewArea = AirPlayInsets(left = 50), safeArea = AirPlayInsets(top = 80),
+            safeAreaDrawOutside = true,
+            viewAreas = listOf(AirPlayViewArea(1920, 1080), AirPlayViewArea(800, 480)), initialViewArea = 1)
+        val result = BmwAirPlayGeometry.mainDisplay(base, 1008, 400)
+        val advertised = info(result)
+        val view = (advertised["viewAreas"] as List<*>).single() as Map<*, *>
+        val safe = view["safeArea"] as Map<*, *>
+        assertEquals(1008, view["widthPixels"]);assertEquals(400, view["heightPixels"])
+        assertEquals(0, safe["originXPixels"]);assertEquals(0, safe["originYPixels"])
+        assertEquals(1008, safe["widthPixels"]);assertEquals(400, safe["heightPixels"])
+        assertEquals(false, safe["drawUIOutsideSafeArea"])
+        assertEquals(0, advertised["initialViewArea"])
+        assertEquals(3, advertised["primaryInputDevice"])
+    }
+
+    @Test fun unsupportedSourceDimensionsAreRejected() {
+        val base = AirPlayDisplayConfig(1920, 1080)
+        assertThrows(IllegalArgumentException::class.java) { BmwAirPlayGeometry.mainDisplay(base, 0, 400) }
+        assertThrows(IllegalArgumentException::class.java) { BmwAirPlayGeometry.mainDisplay(base, 1008, 0) }
+        assertThrows(IllegalArgumentException::class.java) { BmwAirPlayGeometry.mainDisplay(base, 4096, 400) }
+    }
+}

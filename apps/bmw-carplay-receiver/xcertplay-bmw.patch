+package com.shilapi.xcertplay.bmw
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class BmwCapturePolicyTest {
+    @Test fun finalAnimationFrameIsRetainedUntilDueWithoutAnotherDecoderCallback() {
+        val schedule = BmwCaptureSchedule()
+        schedule.decoded()
+        assertEquals(0L, schedule.delayMs(1000, 100))
+        schedule.captured(1000)
+        schedule.decoded() // The final picture arrives inside the throttle window.
+        assertEquals(60L, schedule.delayMs(1040, 100))
+        assertEquals(0L, schedule.delayMs(1100, 100)) // Timer alone releases it.
+        schedule.captured(1100)
+        assertNull(schedule.delayMs(1200, 100)) // No repeated static-frame capture.
+    }
+
+    @Test fun rapidFramesCoalesceAndNewSessionHasNoOldDeadline() {
+        val schedule = BmwCaptureSchedule()
+        schedule.decoded(); schedule.captured(1000)
+        repeat(20) { schedule.decoded() }
+        assertEquals(20L, schedule.delayMs(1080, 100))
+        schedule.captured(1100)
+        assertNull(schedule.delayMs(1100, 100))
+        schedule.decoded(); schedule.reset()
+        assertNull(schedule.delayMs(1101, 100))
+        schedule.decoded()
+        assertEquals(0L, schedule.delayMs(1101, 100))
+    }
+
+    @Test fun inputAcceleratesCaptureTemporarilyWithoutUnboundedTraffic() {
+        val policy = BmwCapturePolicy()
+        assertEquals(100L, policy.intervalMs(1000))
+        policy.interaction(1000)
+        assertEquals(67L, policy.intervalMs(1001))
+        assertEquals(30, policy.jpegQuality(1001))
+        assertEquals(100L, policy.intervalMs(1700))
+        assertEquals(40, policy.jpegQuality(1700))
+    }
+
+    @Test fun slowTransferReducesPayloadAndRecoversGradually() {
+        val policy = BmwCapturePolicy()
+        policy.transferred(500, 50000)
+        assertEquals(20, policy.jpegQuality(1000))
+        assertEquals(200L, policy.intervalMs(1000))
+        policy.interaction(1000)
+        assertEquals(100L, policy.intervalMs(1001))
+        policy.transferred(10, 10000)
+        assertEquals(25, policy.jpegQuality(1000))
+        repeat(20) { policy.transferred(20, 10000) }
+        assertEquals(40, policy.jpegQuality(2000))
+        policy.transferred(-1, 10000); policy.transferred(8000, 0)
+        assertEquals(40, policy.jpegQuality(2000))
+    }
+
+    @Test fun settledPixelsGetOneRefinementEvenWhenDecoderKeepsRepeatingThem() {
+        val state=BmwStillFramePolicy()
+        assertEquals(BmwStillFramePolicy.Pass.MOTION,state.decide(true,1000,0))
+        for (now in 1100L..2100L step 100) {
+            assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,now,0))
+        }
+        assertEquals(BmwStillFramePolicy.Pass.REFINE,state.decide(false,2200,0))
+        repeat(100) {
+            assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,2300L+it*100,0))
+            assertNull(state.nextDelayMs(2300L+it*100,0))
+        }
+        assertTrue(BmwStillFramePolicy.REFINEMENT_QUALITY > BmwCapturePolicy().jpegQuality(2000))
+    }
+
+    @Test fun finalPictureRefinesUsingATimerWithoutAnotherDecoderFrame() {
+        val state=BmwStillFramePolicy()
+        state.decide(true,1000,0)
+        assertEquals(1200L,state.nextDelayMs(1000,0))
+        assertEquals(1L,state.nextDelayMs(2199,0))
+        assertEquals(BmwStillFramePolicy.Pass.REFINE,state.decide(false,2200,0))
+        assertNull(state.nextDelayMs(2200,0))
+    }
+
+    @Test fun continuousMotionCancelsPreviousRefinementDeadline() {
+        val state=BmwStillFramePolicy()
+        for (now in 1000L..5000L step 100) {
+            assertEquals(BmwStillFramePolicy.Pass.MOTION,state.decide(true,now,0))
+            assertEquals(1200L,state.nextDelayMs(now,0))
+        }
+        assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,6199,0))
+        assertEquals(BmwStillFramePolicy.Pass.REFINE,state.decide(false,6200,0))
+        assertEquals(BmwStillFramePolicy.Pass.MOTION,state.decide(true,6300,0))
+        assertEquals(1200L,state.nextDelayMs(6300,0))
+    }
+
+    @Test fun recentInputDefersLargeRefinementWhileWaitingForPhoneResponse() {
+        val state=BmwStillFramePolicy();val capture=BmwCapturePolicy()
+        state.decide(true,1000,0)
+        capture.interaction(1700)
+        assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,1900,capture.interactionUntilMs()))
+        assertEquals(500L,state.nextDelayMs(1900,capture.interactionUntilMs()))
+        assertEquals(BmwStillFramePolicy.Pass.REFINE,state.decide(false,2400,capture.interactionUntilMs()))
+    }
+
+    @Test fun stoppedOrReplacementSessionHasNoOldRefinement() {
+        val state=BmwStillFramePolicy();state.decide(true,1000,0);state.reset()
+        assertNull(state.nextDelayMs(5000,0))
+        assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,5000,0))
+        assertEquals(BmwStillFramePolicy.Pass.MOTION,state.decide(true,5100,0))
+        assertEquals(1200L,state.nextDelayMs(5100,0))
+    }
+
+    @Test fun oneSecondProgressTicksDoNotTriggerRepeatedHighQualityRefreshes() {
+        val state=BmwStillFramePolicy()
+        for (now in 0L..10000L step 1000) {
+            assertEquals(BmwStillFramePolicy.Pass.MOTION,state.decide(true,now,0))
+            assertEquals(BmwStillFramePolicy.Pass.NONE,state.decide(false,now+900,0))
+        }
+    }
+}

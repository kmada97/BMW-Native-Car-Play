diff --git a/shared/src/main/java/com/shilapi/xcertplay/airplay/AudioReceiveStats.kt b/shared/src/main/java/com/shilapi/xcertplay/airplay/AudioReceiveStats.kt
new file mode 100644
index 0000000..ea17676
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/airplay/AudioReceiveStats.kt
@@ -0,0 +1,95 @@
+package com.shilapi.xcertplay.airplay
+
+/**
+ * Metadata only: no packet bytes, addresses, SSRCs or wire timestamps are retained.
+ * Forward gaps count initially absent sequence positions, not confirmed packet loss: a late
+ * packet may subsequently fill one. Duplicate/reorder classification uses a fixed-size history;
+ * older packets are reported separately because their prior arrival can no longer be known.
+ */
+internal class AudioReceiveStats {
+    data class Snapshot(
+        val packets: Long,
+        val forwardGaps: Long,
+        val reordered: Long,
+        val duplicates: Long,
+        val lateOutsideWindow: Long,
+        val windowPackets: Long,
+        val windowMs: Long,
+        val maxArrivalGapUs: Long,
+    )
+
+    private val seen = LongArray(HISTORY_SIZE) { Long.MIN_VALUE }
+    private var highest: Long? = null
+    private var packets = 0L
+    private var forwardGaps = 0L
+    private var reordered = 0L
+    private var duplicates = 0L
+    private var lateOutsideWindow = 0L
+    private var windowPackets = 0L
+    private var windowStartNs: Long? = null
+    private var lastArrivalNs: Long? = null
+    private var maxArrivalGapNs = 0L
+
+    @Synchronized
+    fun record(sequence: Int, arrivalNs: Long) {
+        require(sequence in 0..0xffff)
+        packets++
+        windowPackets++
+        if (windowStartNs == null) windowStartNs = arrivalNs
+        lastArrivalNs?.let { previous ->
+            maxArrivalGapNs = maxOf(maxArrivalGapNs, (arrivalNs - previous).coerceAtLeast(0L))
+        }
+        lastArrivalNs = maxOf(lastArrivalNs ?: arrivalNs, arrivalNs)
+
+        val previous = highest
+        if (previous == null) {
+            highest = sequence.toLong()
+            remember(sequence.toLong())
+            return
+        }
+        val delta = (sequence - (previous.toInt() and 0xffff)) and 0xffff
+        val extended = when {
+            delta == 0 -> previous
+            delta < HALF_SEQUENCE_RANGE -> previous + delta
+            else -> previous - (SEQUENCE_RANGE - delta)
+        }
+        when {
+            extended > previous -> {
+                forwardGaps += extended - previous - 1L
+                highest = extended
+                remember(extended)
+            }
+            previous - extended >= HISTORY_SIZE -> lateOutsideWindow++
+            seen[slot(extended)] == extended -> duplicates++
+            else -> {
+                reordered++
+                remember(extended)
+            }
+        }
+    }
+
+    @Synchronized
+    fun due(nowNs: Long, intervalNs: Long): Boolean =
+        windowStartNs?.let { nowNs - it >= intervalNs } ?: false
+
+    /** Keeps cumulative sequence counters; resets only this reporting interval's timing data. */
+    @Synchronized
+    fun snapshot(nowNs: Long): Snapshot {
+        val result = Snapshot(packets, forwardGaps, reordered, duplicates, lateOutsideWindow,
+            windowPackets, ((nowNs - (windowStartNs ?: nowNs)).coerceAtLeast(0L)) / 1_000_000L,
+            maxArrivalGapNs / 1_000L)
+        windowPackets = 0L
+        maxArrivalGapNs = 0L
+        windowStartNs = nowNs
+        return result
+    }
+
+    private fun remember(sequence: Long) { seen[slot(sequence)] = sequence }
+    private fun slot(sequence: Long): Int = sequence.toInt() and (HISTORY_SIZE - 1)
+
+    private companion object {
+        const val HISTORY_SIZE = 256
+        const val SEQUENCE_RANGE = 65_536
+        const val HALF_SEQUENCE_RANGE = SEQUENCE_RANGE / 2
+    }
+}

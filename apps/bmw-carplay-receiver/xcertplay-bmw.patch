+package com.shilapi.xcertplay.media
+
+/** Fixed numeric fields only; no MediaFormat dump, codec bytes, stream identifiers or phone data. */
+internal object VideoGeometryMetadata {
+    fun sps(parameters: VideoParameters, negotiatedWidth: Int, negotiatedHeight: Int): String {
+        val aspect = parameters.pixelWidthHeightRatio.takeIf { it.isFinite() && it > 0 } ?: -1f
+        return "video geometry sps width=${parameters.width} height=${parameters.height} " +
+            "pixelAspect=$aspect negotiatedWidth=$negotiatedWidth negotiatedHeight=$negotiatedHeight " +
+            "standard=${parameters.colorStandard} range=${parameters.colorRange} transfer=${parameters.colorTransfer}"
+    }
+
+    fun output(width: Int?, height: Int?, cropLeft: Int?, cropTop: Int?, cropRight: Int?, cropBottom: Int?,
+               stride: Int?, slice: Int?, standard: Int?, range: Int?, transfer: Int?): String =
+        "video geometry output width=${width ?: -1} height=${height ?: -1} " +
+            "cropLeft=${cropLeft ?: -1} cropTop=${cropTop ?: -1} " +
+            "cropRight=${cropRight ?: -1} cropBottom=${cropBottom ?: -1} " +
+            "visibleWidth=${visible(width,cropLeft,cropRight)} visibleHeight=${visible(height,cropTop,cropBottom)} " +
+            "stride=${stride ?: -1} slice=${slice ?: -1} standard=${standard ?: -1} " +
+            "range=${range ?: -1} transfer=${transfer ?: -1}"
+
+    /** MediaCodec crop-right/bottom are inclusive. Invalid/missing dimensions remain unknown. */
+    private fun visible(size: Int?, start: Int?, end: Int?): Int {
+        if (size == null || size <= 0) return -1
+        val first = start ?: 0
+        val last = end ?: (size - 1)
+        return if (first >= 0 && last >= first && last < size) last - first + 1 else -1
+    }
+}

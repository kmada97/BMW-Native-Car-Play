@@ -0,0 +1,57 @@
+package com.shilapi.xcertplay.bmw;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.bouncycastle.asn1.x500.X500Name;
+import org.bouncycastle.cert.X509CertificateHolder;
+import org.bouncycastle.cert.jcajce.JcaX509v3CertificateBuilder;
+import org.bouncycastle.cms.CMSAbsentContent;
+import org.bouncycastle.cms.CMSSignedData;
+import org.bouncycastle.cms.CMSSignedDataGenerator;
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+import org.bouncycastle.util.CollectionStore;
+
+public class BmwCertificatesTest {
+    private X509CertificateHolder cert(String name) throws Exception {
+        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(1024); // ephemeral test identity only, never sent or persisted
+        KeyPair key = generator.generateKeyPair();
+        X500Name subject = new X500Name("CN=" + name);
+        return new JcaX509v3CertificateBuilder(subject, BigInteger.ONE, new Date(0),
+            new Date(4102444800000L), subject, key.getPublic())
+            .build(new JcaContentSignerBuilder("SHA256withRSA").build(key.getPrivate()));
+    }
+    private byte[] bundle(X509CertificateHolder... certificates) throws Exception {
+        CMSSignedDataGenerator generator = new CMSSignedDataGenerator();
+        generator.addCertificates(new CollectionStore<>(Arrays.asList(certificates)));
+        return generator.generate(new CMSAbsentContent()).getEncoded();
+    }
+    @Test public void replacesRootWithConnectionChainAndPreservesApplication() throws Exception {
+        X509CertificateHolder application = cert("test_application");
+        byte[] original = bundle(application, cert("a4a_root-ca"));
+        byte[] merged = BmwCertificates.mergeBMWCert(original,
+            bundle(cert("BMW CONNECTION test"), cert("unrelated")));
+        CMSSignedData parsed = BmwCertificates.parse(merged);
+        Set<String> names = parsed.getCertificates().getMatches(null).stream()
+            .map(BmwCertificates::commonName).collect(Collectors.toSet());
+        assertEquals(Set.of("test_application", "BMW CONNECTION test"), names);
+        assertTrue(parsed.getCertificates().getMatches(null).contains(application));
+        assertEquals(BmwCertificates.parse(original).getSignerInfos().size(), parsed.getSignerInfos().size());
+        // Output is PEM; using it again must retain the same application certificate.
+        assertNotNull(BmwCertificates.parse(BmwCertificates.mergeBMWCert(merged,
+            bundle(cert("BMW connection replacement")))));
+    }
+    @Test(expected = IllegalArgumentException.class) public void rejectsMissingConnectionCertificate() throws Exception {
+        BmwCertificates.mergeBMWCert(bundle(cert("test_application")), bundle(cert("unrelated")));
+    }
+    @Test(expected = IllegalArgumentException.class) public void rejectsEmptyCertificate() throws Exception {
+        BmwCertificates.parse(new byte[0]);
+    }
+}

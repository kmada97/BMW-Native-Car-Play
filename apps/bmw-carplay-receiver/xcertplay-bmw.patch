diff --git a/shared/src/main/java/com/shilapi/xcertplay/media/AudioDecodePump.kt b/shared/src/main/java/com/shilapi/xcertplay/media/AudioDecodePump.kt
new file mode 100644
index 0000000..20bdb17
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/media/AudioDecodePump.kt
@@ -0,0 +1,30 @@
+package com.shilapi.xcertplay.media
+
+/**
+ * Keeps one access unit until the codec accepts it. The owner ticks on a timed wait even when
+ * RTP is idle: output readiness must not depend on the next input packet or an available input
+ * buffer. The network queue remains separately bounded; this pump never accumulates a backlog.
+ */
+internal class AudioDecodePump(private val port: Port) {
+    interface Port {
+        fun drain()
+        /** Nonblocking; false means retry this same access unit on a later tick. */
+        fun queue(bytes: ByteArray, presentationTimeUs: Long): Boolean
+    }
+
+    private data class Input(val bytes: ByteArray, val presentationTimeUs: Long)
+    private var pending: Input? = null
+    val hasPending: Boolean get() = pending != null
+
+    fun submit(bytes: ByteArray, presentationTimeUs: Long) {
+        check(pending == null) { "Audio input must be accepted before advancing the RTP queue" }
+        pending = Input(bytes, presentationTimeUs)
+    }
+
+    fun tick() {
+        // Draining can release codec resources needed to make an input slot available.
+        port.drain()
+        pending?.let { if (port.queue(it.bytes, it.presentationTimeUs)) pending = null }
+        port.drain()
+    }
+}

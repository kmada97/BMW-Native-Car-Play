@@ -0,0 +1,188 @@
+package com.shilapi.xcertplay.bmw
+
+import android.app.Activity
+import android.content.Intent
+import android.graphics.Color
+import android.graphics.BitmapFactory
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ImageView
+import android.widget.ScrollView
+import android.widget.TextView
+import com.shilapi.xcertplay.AirPlayPersistence
+import com.shilapi.xcertplay.CarPlayHostActivity
+import com.shilapi.xcertplay.orchestration.MfiTarget
+
+/** One entry point for the combined receiver/display checkpoint; no setup wizard or fake phone UI. */
+class BmwCheckpointActivity : Activity() {
+    private val handler = Handler(Looper.getMainLooper())
+    private val launchGate = ForegroundLaunchGate()
+    private var pendingMode: String? = null
+    private val dispatchMode = Runnable {
+        if (launchGate.consume()) {
+            val mode = pendingMode
+            pendingMode = null
+            when (mode) {
+                "receiver" -> startReceiver()
+                "decoder-test" -> startLocalTest()
+                "stop" -> stopBridge()
+            }
+        }
+    }
+    private lateinit var status: TextView
+    private lateinit var preview: ImageView
+    private var previewSequence = -1L
+    private var message = ""
+    private val refresh = object : Runnable {
+        override fun run() {
+            status.text = listOf(message, authenticationStatus(), BmwBridge.statusText())
+                .filter { it.isNotBlank() }.joinToString("\n\n")
+            // Only synthetic decoder-test images may be written for this local checkpoint report.
+            // Never persist live phone pixels, destinations, artwork or other personal content here.
+            val frame = BmwBridge.getLatestFrame()
+            if (frame?.source == BmwBridge.DECODER_TEST && frame.sequence != previewSequence) {
+                previewSequence = frame.sequence
+                preview.setImageBitmap(BitmapFactory.decodeByteArray(frame.jpeg, 0, frame.jpeg.size))
+                runCatching {
+                    val report = java.io.File(filesDir, "bmw-decoder-test").apply { mkdirs() }
+                    java.io.File(report, "latest.jpg").writeBytes(frame.jpeg)
+                    java.io.File(report, "result.json").writeText(org.json.JSONObject()
+                        .put("source", frame.source).put("sequence", frame.sequence)
+                        .put("width", frame.width).put("height", frame.height)
+                        .put("jpeg_bytes", frame.jpeg.size).put("captured_at_ms", frame.capturedAtMs)
+                        .put("iphone_authenticated", false).put("car_tested", false).toString(2))
+                }
+            }
+            handler.postDelayed(this, 1000)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        BmwStartupTrace.mark(this, BmwStartupTrace.Stage.CHECKPOINT_CREATED)
+        val layout = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(28, 28, 28, 28)
+            setBackgroundColor(Color.rgb(18, 23, 31))
+        }
+        fun text(value: String, size: Float) = TextView(this).apply {
+            text = value; textSize = size; setTextColor(Color.WHITE); setPadding(0, 10, 0, 16)
+            layout.addView(this)
+        }
+        text("BMW Receiver — Checkpoint 1", 25f)
+        text("Real receiver + BMW display and knob bridge. iPhone projection requires an accepted authentication identity. The local video test checks decoding and display only.", 17f)
+        status = text("", 17f)
+        preview = ImageView(this).apply { adjustViewBounds = true; layout.addView(this) }
+        fun button(label: String, action: () -> Unit) {
+            layout.addView(Button(this).apply { text = label; setOnClickListener { action() } },
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+        button("Start iPhone receiver + BMW") { startReceiver() }
+        button("Run local video test — no iPhone") { startLocalTest() }
+        button("Receiver authentication settings") {
+            startActivity(Intent(this, CarPlayHostActivity::class.java).putExtra("bmw_settings_only", true))
+        }
+        button("Stop BMW display / local test") { stopBridge() }
+        text("Uses the existing SmartThings entry in BMW Apps. Live projection stays connected until stop or disconnect; the local video test is limited to 15 minutes. Factory Back/Menu stays available.", 15f)
+        setContentView(ScrollView(this).apply { addView(layout) })
+        handleIntent(intent)
+    }
+
+    override fun onNewIntent(intent: Intent) { super.onNewIntent(intent); setIntent(intent); handleIntent(intent) }
+    private fun handleIntent(intent: Intent) {
+        val mode = intent.getStringExtra("mode")
+        intent.removeExtra("mode")
+        if (mode in listOf("receiver", "decoder-test", "stop")) {
+            pendingMode = mode
+            launchGate.request()
+            scheduleMode()
+        }
+    }
+    override fun onResume() {
+        super.onResume()
+        handler.removeCallbacks(refresh); handler.post(refresh)
+        launchGate.resume(); launchGate.focus(hasWindowFocus()); scheduleMode()
+    }
+    override fun onWindowFocusChanged(hasFocus: Boolean) {
+        super.onWindowFocusChanged(hasFocus)
+        launchGate.focus(hasFocus)
+        if (hasFocus) BmwStartupTrace.mark(this, BmwStartupTrace.Stage.CHECKPOINT_FOCUSED)
+        if (hasFocus) scheduleMode() else handler.removeCallbacks(dispatchMode)
+    }
+    override fun onPause() {
+        launchGate.pause()
+        handler.removeCallbacks(dispatchMode); handler.removeCallbacks(refresh)
+        super.onPause()
+    }
+    override fun onDestroy() {
+        launchGate.close()
+        handler.removeCallbacks(dispatchMode); handler.removeCallbacks(refresh)
+        super.onDestroy()
+    }
+    private fun scheduleMode() {
+        handler.removeCallbacks(dispatchMode)
+        handler.post(dispatchMode)
+    }
+
+    private fun authenticationStatus(): String = when (AirPlayPersistence.loadMfiTarget(this)) {
+        MfiTarget.LOCAL_FILES -> if (AirPlayPersistence.loadLocalMfiCertificateUri(this).isNotBlank() &&
+            AirPlayPersistence.loadLocalMfiPrivateKeyUri(this).isNotBlank())
+            "Authentication files selected; acceptance by the iPhone is unverified."
+            else "iPhone projection blocked: no certificate and matching private key selected."
+        MfiTarget.REMOTE -> if (remoteConfigured())
+            "Signing service configured; availability and iPhone acceptance are unverified."
+            else "iPhone projection blocked: no valid signing service configured."
+        else -> "iPhone projection blocked: the selected hardware authentication device is not part of this Pi setup."
+    }
+    private fun remoteConfigured(): Boolean = runCatching {
+        val uri = java.net.URI(AirPlayPersistence.loadRemoteMfiServer(this))
+        uri.scheme in listOf("https", "http") && !uri.host.isNullOrBlank() && uri.userInfo == null
+    }.getOrDefault(false)
+    private fun authenticationConfigured(): Boolean = when (AirPlayPersistence.loadMfiTarget(this)) {
+        MfiTarget.LOCAL_FILES -> AirPlayPersistence.loadLocalMfiCertificateUri(this).isNotBlank() &&
+            AirPlayPersistence.loadLocalMfiPrivateKeyUri(this).isNotBlank()
+        MfiTarget.REMOTE -> remoteConfigured()
+        else -> false
+    }
+    private fun arm(live: Boolean) {
+        startService(Intent(this, BmwRhmiService::class.java)
+            .setAction(if (live) BmwRhmiService.ARM_LIVE else BmwRhmiService.ARM))
+    }
+    private fun startReceiver() {
+        if (!authenticationConfigured()) {
+            message = "Receiver not started. Authentication must be configured before a live phone test."
+            return
+        }
+        BmwBridge.stopDecoderTest()
+        BmwBridge.configureDisplay(this)
+        BmwBridge.setEnabled(true)
+        val first = getSharedPreferences("bmw_checkpoint", MODE_PRIVATE)
+        if (!first.getBoolean("receiver_defaults_set", false)) {
+            AirPlayPersistence.saveWirelessEnabled(this, true)
+            AirPlayPersistence.saveHevcEnabled(this, false)
+            AirPlayPersistence.saveFps(this, 15)
+            first.edit().putBoolean("receiver_defaults_set", true).apply()
+        }
+        arm(live = true)
+        BmwStartupTrace.mark(this, BmwStartupTrace.Stage.RECEIVER_ARMED)
+        startActivity(Intent(this, CarPlayHostActivity::class.java))
+    }
+    private fun startLocalTest() {
+        BmwBridge.setEnabled(true)
+        previewSequence = -1
+        if (BmwBridge.startDecoderTest(this)) {
+            arm(live = false)
+            message = "Local H264 video test started. No iPhone connection or CarPlay authentication is being tested. Open SmartThings once the BMW connects."
+        } else message = "Local video test could not start. See the receiver status below."
+    }
+    private fun stopBridge() {
+        BmwBridge.stop()
+        preview.setImageDrawable(null)
+        startService(Intent(this, BmwRhmiService::class.java).setAction(BmwRhmiService.STOP))
+        message = "BMW display and local test stopped. Any separate iPhone receiver session is controlled in its settings."
+    }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwDecoderTest.kt b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwDecoderTest.kt
new file mode 100644

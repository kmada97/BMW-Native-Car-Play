+package com.shilapi.xcertplay.bmw;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class BmwArmLatchTest {
+    private static final class MemoryStore implements BmwArmLatch.Store {
+        boolean armed,live;
+        public boolean armed(){return armed;}
+        public boolean live(){return live;}
+        public void save(boolean armed,boolean live){this.armed=armed;this.live=live;}
+    }
+    @Test public void liveReconnectAndServiceRecreationRetainPermissionUntilStop(){
+        MemoryStore store=new MemoryStore();BmwArmLatch latch=new BmwArmLatch(store);
+        assertNull(latch.claim());latch.arm(true);
+        assertTrue(latch.claim().live);
+        // USB unbind and rebind do not create a new explicit arm request.
+        assertTrue(latch.claim().live);
+        latch=new BmwArmLatch(store);assertTrue(latch.claim().live);
+        latch.stop();assertNull(latch.claim());
+        assertNull(new BmwArmLatch(store).claim());
+    }
+    @Test public void localTestsRemainOneShotEvenAfterAConnectionFailure(){
+        BmwArmLatch latch=new BmwArmLatch(new MemoryStore());latch.arm(false);
+        BmwArmLatch.Request local=latch.claim();assertFalse(local.live);
+        assertTrue(latch.isCurrent(local));assertNull(latch.claim());
+        latch.arm(false);assertNotNull(latch.claim());
+    }
+    @Test public void stopInvalidatesClaimBeforeTransportGuardInstallation(){
+        BmwArmLatch latch=new BmwArmLatch(new MemoryStore());latch.arm(true);
+        BmwArmLatch.Request request=latch.claim();latch.stop();
+        assertFalse(latch.isCurrent(request));assertNull(latch.pendingMode());
+        latch.arm(true);assertTrue(latch.claim().live);
+        assertFalse(latch.isCurrent(request));
+    }
+    @Test public void switchingToLocalDoesNotInheritPersistentLivePermission(){
+        BmwArmLatch latch=new BmwArmLatch(new MemoryStore());latch.arm(true);
+        BmwArmLatch.Request live=latch.claim();latch.arm(false);
+        assertEquals(Boolean.FALSE,latch.pendingMode());assertFalse(latch.isCurrent(live));
+        assertFalse(latch.claim().live);assertNull(latch.claim());
+    }
+}
diff --git a/common/src/test/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSenderTest.java b/common/src/test/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSenderTest.java
new file mode 100644
index 0000000..5aeb4ca
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/bmw/BmwAsyncImageSenderTest.java
@@ -0,0 +1,112 @@
+package com.shilapi.xcertplay.bmw;
+
+import java.io.IOException;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.etch.bindings.java.msg.Message;
+import org.apache.etch.bindings.java.support.Mailbox;
+import org.apache.etch.util.core.Who;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class BmwAsyncImageSenderTest {
+    private static final class Deadline implements ScheduledFuture<Object> {
+        final Runnable task;boolean cancelled;
+        Deadline(Runnable task){this.task=task;}
+        void fire(){if(!cancelled)task.run();}
+        public boolean cancel(boolean interrupt){cancelled=true;return true;}
+        public boolean isCancelled(){return cancelled;}
+        public boolean isDone(){return cancelled;}
+        public Object get(){return null;}
+        public Object get(long n,TimeUnit unit){return null;}
+        public long getDelay(TimeUnit unit){return 0;}
+        public int compareTo(Delayed other){return 0;}
+    }
+    private static final class Timers extends ScheduledThreadPoolExecutor {
+        final List<Deadline> deadlines=new ArrayList<>();
+        Timers(){super(1);}
+        @Override public ScheduledFuture<?> schedule(Runnable command,long delay,TimeUnit unit){
+            Deadline result=new Deadline(command);deadlines.add(result);return result;
+        }
+        @Override public void execute(Runnable command){command.run();}
+    }
+    private static final class Box implements Mailbox {
+        boolean full,closed;Notify notify;Object state;
+        void reply(){full=true;signal();}
+        void signal(){Notify n=notify;if(n!=null)n.mailboxStatus(this,state,closed);}
+        public Long getMessageId(){return 1L;}
+        public boolean message(Who who,Message message){reply();return true;}
+        public Element read(){throw new AssertionError("Only generated end owns mailbox reads");}
+        public Element read(int timeout){throw new AssertionError("Only generated end owns mailbox reads");}
+        public boolean closeDelivery(){closed=true;signal();return true;}
+        public boolean closeRead(){closed=true;return true;}
+        public void registerNotify(Notify n,Object state,int timeout){notify=n;this.state=state;if(full||closed)signal();}
+        public void unregisterNotify(Notify n){if(notify==n)notify=null;}
+        public boolean isEmpty(){return !full;}
+        public boolean isClosed(){return closed;}
+        public boolean isFull(){return full;}
+    }
+    private static final class Harness implements AutoCloseable {
+        final Timers timers=new Timers();final Deque<Runnable> queue=new ArrayDeque<>();
+        final AtomicLong clock=new AtomicLong(100000000L);final Box box=new Box();
+        final List<BmwAsyncImageSender.Result> results=new ArrayList<>();
+        final BmwProbeGuard guard=new BmwProbeGuard(timers,0,reason->{});
+        int starts,ends;boolean failBegin,failEnd;
+        final BmwAsyncImageSender sender=new BmwAsyncImageSender(new BmwAsyncImageSender.Calls(){
+            public Mailbox begin(byte[] bytes) throws Exception {
+                starts++;clock.addAndGet(10000000L);if(failBegin)throw new IOException("begin failed");return box;
+            }
+            public void end(Mailbox mailbox) throws Exception {
+                ends++;if(failEnd||box.isEmpty())throw new IOException("peer response failed");
+            }
+        },guard,timers,queue::add,clock::get);
+        boolean send(){return sender.send(new byte[]{1,2},results::add);}
+        void drain(){while(!queue.isEmpty())queue.remove().run();}
+        public void close(){sender.close();timers.shutdownNow();}
+    }
+    @Test public void singleFlightLeavesControlWorkerAvailableWhileWaiting(){
+        try(Harness h=new Harness()){
+            assertTrue(h.send());assertTrue(h.sender.busy());assertFalse(h.send());
+            int[] controls={0};h.queue.add(()->controls[0]++);h.drain();
+            assertEquals(1,controls[0]);assertEquals(0,h.ends);
+            h.clock.set(250000000L);h.box.reply();assertEquals(0,h.ends);
+            h.clock.set(260000000L);h.drain();
+            assertEquals(1,h.ends);assertFalse(h.sender.busy());assertEquals(1,h.starts);
+            BmwAsyncImageSender.Result result=h.results.get(0);assertNull(result.error);
+            assertEquals(100000000L,result.startedNs);assertEquals(110000000L,result.beginFinishedNs);
+            assertEquals(250000000L,result.responseNs);assertEquals(260000000L,result.handledNs);
+        }
+    }
+    @Test public void alreadyFullMailboxAndRepeatedNotificationsCompleteOnce(){
+        try(Harness h=new Harness()){
+            h.box.full=true;assertTrue(h.send());h.box.signal();h.box.closeDelivery();
+            assertEquals(1,h.queue.size());h.drain();assertEquals(1,h.ends);assertEquals(1,h.results.size());
+        }
+    }
+    @Test public void stoppedSessionIgnoresQueuedCompletion(){
+        try(Harness h=new Harness()){
+            h.send();h.box.reply();h.sender.close();h.drain();
+            assertEquals(0,h.ends);assertTrue(h.results.isEmpty());assertFalse(h.send());
+        }
+    }
+    @Test public void deadlineCancelsSessionInsteadOfStartingAnotherImage(){
+        try(Harness h=new Harness()){
+            h.send();h.timers.deadlines.get(0).fire();assertTrue(h.guard.isCancelled());
+            h.box.reply();h.drain();assertEquals(1,h.results.size());
+            assertTrue(h.results.get(0).error instanceof TimeoutException);assertFalse(h.send());
+        }
+    }
+    @Test public void emptyClosedMailboxAndPeerFailureFailSession(){
+        for(boolean peerFailure:new boolean[]{false,true})try(Harness h=new Harness()){
+            h.send();h.failEnd=peerFailure;if(peerFailure)h.box.reply();else h.box.closeDelivery();h.drain();
+            assertTrue(h.guard.isCancelled());assertNotNull(h.results.get(0).error);assertEquals(1,h.ends);
+        }
+    }
+    @Test public void synchronousBeginFailureCompletesAndCancels(){
+        try(Harness h=new Harness()){
+            h.failBegin=true;assertTrue(h.send());h.drain();assertFalse(h.sender.busy());
+            assertNotNull(h.results.get(0).error);assertTrue(h.guard.isCancelled());assertEquals(0,h.ends);
+        }
+    }
+}

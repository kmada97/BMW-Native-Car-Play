index 0000000..348b356
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwDisplayLayout.java
@@ -0,0 +1,97 @@
+package com.shilapi.xcertplay.bmw;
+
+import io.bimmergestalt.idriveconnectkit.RHMIDimensions;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * The normal RHMI content rectangle, clear of the head unit's own navigation/header.
+ *
+ * RHMIDimensions' visible rectangle deliberately draws underneath the removable
+ * padding. That is useful for maps, but obscures CarPlay controls on this ID4 head
+ * unit. Keep that padding and have the phone render for the smaller clean canvas.
+ */
+public final class BmwDisplayLayout {
+    public static final String WIDE_PROFILE_PREFERENCE = "wide_id4_display_profile";
+    public static final int WIDE_PROFILE_DISPLAY_WIDTH = 1280;
+    public static final int WIDE_PROFILE_DISPLAY_HEIGHT = 480;
+    /** Photo-based allowance for ID4's curved right options strip, not a reported capability. */
+    public static final int ID4_OPTIONS_GUTTER = 80;
+    /** Invalidate persisted rectangles whenever the native-chrome reservation changes. */
+    public static final int GEOMETRY_VERSION = 2;
+    private static final String WIDTH = "hmi.display-width";
+    private static final String HEIGHT = "hmi.display-height";
+
+    public final RHMIDimensions dimensions;
+    public final int imageX = 0, imageY = 0;
+    public final int canvasWidth, canvasHeight, sourceWidth, sourceHeight;
+    public final int nativeLeft, nativeTop, nativeRight;
+    public final String widthBasis, heightBasis;
+    public final boolean usedWideProfile;
+
+    private BmwDisplayLayout(RHMIDimensions dimensions, String widthBasis, String heightBasis, boolean bmwId4) {
+        this.dimensions = dimensions;
+        this.widthBasis = widthBasis;
+        this.heightBasis = heightBasis;
+        usedWideProfile = widthBasis.equals("selected_wide_id4_profile") ||
+                heightBasis.equals("selected_wide_id4_profile");
+        nativeLeft = dimensions.getMarginLeft() + dimensions.getPaddingLeft();
+        nativeTop = dimensions.getPaddingTop();
+        nativeRight = Math.max(dimensions.getMarginRight(), bmwId4 ? ID4_OPTIONS_GUTTER : 0);
+        canvasWidth = dimensions.getRhmiWidth() - nativeLeft - nativeRight;
+        canvasHeight = dimensions.getAppHeight();
+        if (canvasWidth < 200 || canvasWidth > 2048 || canvasHeight < 200 || canvasHeight > 1024 ||
+                nativeLeft < 0 || nativeTop < 0) {
+            throw new IllegalArgumentException("Unsupported RHMI content dimensions");
+        }
+        // Keep advertised source geometry macroblock aligned, as in the existing
+        // receiver. Capture fits only this small difference; no crop or stretch.
+        sourceWidth = align16(canvasWidth);
+        sourceHeight = align16(canvasHeight);
+    }
+
+    /**
+     * A separately selected vehicle profile is a fallback, never a capability.
+     * This car's photographed wide ID4 panel motivates the 1280x480 profile;
+     * dimensions actually reported by the car always take precedence per axis.
+     * Turning the profile off restores the dependency's original 800x480 defaults.
+     */
+    public static BmwDisplayLayout resolve(Map<String, String> capabilities, boolean selectedWideId4Profile) {
+        Map<String, String> effective = new HashMap<>(capabilities);
+        String type = capabilities.get("hmi.type");
+        boolean bmwId4 = type != null && type.startsWith("BMW") && type.contains("ID4");
+        boolean profileApplies = selectedWideId4Profile && bmwId4;
+        String widthBasis = resolveAxis(effective, WIDTH, profileApplies ? WIDE_PROFILE_DISPLAY_WIDTH : null);
+        String heightBasis = resolveAxis(effective, HEIGHT, profileApplies ? WIDE_PROFILE_DISPLAY_HEIGHT : null);
+        return new BmwDisplayLayout(RHMIDimensions.Companion.create(effective), widthBasis, heightBasis, bmwId4);
+    }
+
+    /** Initial phone negotiation uses the explicitly selected vehicle profile. */
+    public static BmwDisplayLayout selectedWideId4Profile() {
+        Map<String, String> caps = new HashMap<>();
+        caps.put("hmi.type", "BMW ID4++");
+        return resolve(caps, true);
+    }
+
+    private static String resolveAxis(Map<String, String> capabilities, String key, Integer profileValue) {
+        String value = capabilities.get(key);
+        if (value != null && !value.trim().isEmpty()) {
+            // Malformed/nonpositive reports are not permission to invent geometry.
+            try {
+                if (Integer.parseInt(value.trim()) <= 0) throw new NumberFormatException();
+            } catch (NumberFormatException invalid) {
+                throw new IllegalArgumentException("Invalid reported RHMI dimension: " + key);
+            }
+            capabilities.put(key, value.trim());
+            return "reported_capability";
+        }
+        capabilities.remove(key);
+        if (profileValue != null) {
+            capabilities.put(key, Integer.toString(profileValue));
+            return "selected_wide_id4_profile";
+        }
+        return "library_default";
+    }
+
+    private static int align16(int value) { return (value + 15) & ~15; }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwEglCapture.kt b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwEglCapture.kt

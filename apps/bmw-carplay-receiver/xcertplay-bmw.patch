+++ b/shared/src/test/java/com/shilapi/xcertplay/airplay/AudioReceiveStatsTest.kt
@@ -0,0 +1,112 @@
+package com.shilapi.xcertplay.airplay
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AudioReceiveStatsTest {
+    @Test
+    fun sequentialTrafficMeasuresArrivalGapWithoutSequenceErrors() {
+        val stats = AudioReceiveStats()
+        stats.record(12, 0L)
+        stats.record(13, 20_000_000L)
+        stats.record(14, 75_000_000L)
+        val result = stats.snapshot(100_000_000L)
+        assertEquals(3L, result.packets)
+        assertEquals(3L, result.windowPackets)
+        assertEquals(100L, result.windowMs)
+        assertEquals(55_000L, result.maxArrivalGapUs)
+        assertEquals(0L, result.forwardGaps)
+        assertEquals(0L, result.duplicates)
+        assertEquals(0L, result.reordered)
+    }
+
+    @Test
+    fun lateArrivalCanFillAForwardGapWithoutBeingCalledNewLoss() {
+        val stats = AudioReceiveStats()
+        listOf(20, 24, 22, 21, 23, 25).forEachIndexed { index, sequence ->
+            stats.record(sequence, index * 1_000_000L)
+        }
+        val result = stats.snapshot(10_000_000L)
+        assertEquals(3L, result.forwardGaps)
+        assertEquals(3L, result.reordered)
+        assertEquals(0L, result.duplicates)
+        assertEquals(0L, result.lateOutsideWindow)
+    }
+
+    @Test
+    fun repeatedRecentPacketsAreDuplicatesRatherThanReorderedPackets() {
+        val stats = AudioReceiveStats()
+        listOf(10, 11, 11, 10, 13, 12, 12).forEachIndexed { index, sequence ->
+            stats.record(sequence, index * 1_000_000L)
+        }
+        val result = stats.snapshot(10_000_000L)
+        assertEquals(1L, result.forwardGaps)
+        assertEquals(1L, result.reordered)
+        assertEquals(3L, result.duplicates)
+    }
+
+    @Test
+    fun sequenceWrapDoesNotInventLoss() {
+        val stats = AudioReceiveStats()
+        listOf(65534, 65535, 0, 1, 0).forEachIndexed { index, sequence ->
+            stats.record(sequence, index * 1_000_000L)
+        }
+        val result = stats.snapshot(10_000_000L)
+        assertEquals(0L, result.forwardGaps)
+        assertEquals(0L, result.reordered)
+        assertEquals(1L, result.duplicates)
+    }
+
+    @Test
+    fun gapsAndReorderingAcrossWrapKeepTheirMeaning() {
+        val stats = AudioReceiveStats()
+        listOf(65535, 2, 0, 1, 65535).forEachIndexed { index, sequence ->
+            stats.record(sequence, index * 1_000_000L)
+        }
+        val result = stats.snapshot(10_000_000L)
+        assertEquals(2L, result.forwardGaps)
+        assertEquals(2L, result.reordered)
+        assertEquals(1L, result.duplicates)
+    }
+
+    @Test
+    fun packetsOutsideBoundedHistoryDoNotGetFalseDuplicateClassification() {
+        val stats = AudioReceiveStats()
+        for (sequence in 0..300) stats.record(sequence, sequence * 1_000_000L)
+        stats.record(0, 301_000_000L)
+        val result = stats.snapshot(310_000_000L)
+        assertEquals(1L, result.lateOutsideWindow)
+        assertEquals(0L, result.duplicates)
+        assertEquals(0L, result.forwardGaps)
+    }
+
+    @Test
+    fun snapshotsResetWindowTimingButRetainSequenceAndGapAcrossBoundary() {
+        val stats = AudioReceiveStats()
+        stats.record(5, 0L)
+        assertFalse(stats.due(4_999_999_999L, 5_000_000_000L))
+        assertTrue(stats.due(5_000_000_000L, 5_000_000_000L))
+        stats.snapshot(5_000_000_000L)
+        stats.record(7, 6_000_000_000L)
+        val result = stats.snapshot(10_000_000_000L)
+        assertEquals(2L, result.packets)
+        assertEquals(1L, result.windowPackets)
+        assertEquals(1L, result.forwardGaps)
+        assertEquals(5_000L, result.windowMs)
+        assertEquals(6_000_000L, result.maxArrivalGapUs)
+    }
+
+    @Test
+    fun severalSequenceWrapsDoNotGrowTheHistoryOrInventDuplicates() {
+        val stats = AudioReceiveStats()
+        repeat(200_000) { stats.record(it and 0xffff, it * 1_000L) }
+        val result = stats.snapshot(200_000_000L)
+        assertEquals(200_000L, result.packets)
+        assertEquals(0L, result.forwardGaps)
+        assertEquals(0L, result.duplicates)
+        assertEquals(0L, result.reordered)
+        assertEquals(0L, result.lateOutsideWindow)
+    }
+}

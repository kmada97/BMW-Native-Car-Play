@@ -0,0 +1,54 @@
+package com.shilapi.xcertplay.bmw;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+import java.io.InterruptedIOException;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+
+public final class BmwProbeGuardTest {
+    @Test public void watchdogCancelsOutsideBlockedWorker() throws Exception {
+        ScheduledExecutorService timers=Executors.newScheduledThreadPool(2);
+        CountDownLatch unblock=new CountDownLatch(1);AtomicInteger cancellations=new AtomicInteger();
+        BmwProbeGuard guard=new BmwProbeGuard(timers,0,reason->{cancellations.incrementAndGet();unblock.countDown();});
+        try {
+            long before=System.nanoTime();
+            try{guard.call("blocked",40,()->{unblock.await(2,TimeUnit.SECONDS);return "reply";});fail("Cancelled call cannot return success");}
+            catch(InterruptedIOException expected){}
+            assertTrue("Watchdog independent of blocked worker",(System.nanoTime()-before)/1e6<1000);
+            guard.cancel("again");assertEquals(1,cancellations.get());
+            try{guard.call("later",40,()->"reply");fail("Later call rejected");}catch(InterruptedIOException expected){}
+        }finally{guard.cancel("cleanup");timers.shutdownNow();}
+    }
+    @Test public void cancellationDoesNotBlockCallerOnTransportClose() throws Exception {
+        ScheduledExecutorService timers=Executors.newScheduledThreadPool(2);CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
+        BmwProbeGuard guard=new BmwProbeGuard(timers,2000,reason->{entered.countDown();try{release.await(2,TimeUnit.SECONDS);}catch(InterruptedException ignored){}});
+        try{long before=System.nanoTime();guard.cancel("stop");assertTrue((System.nanoTime()-before)/1e6<100);assertTrue(entered.await(1,TimeUnit.SECONDS));}
+        finally{release.countDown();timers.shutdownNow();}
+    }
+    @Test public void liveSessionHasNoWallClockDeadlineButExplicitStopStillWorks() throws Exception {
+        ScheduledThreadPoolExecutor timers=new ScheduledThreadPoolExecutor(1);
+        CountDownLatch cancelled=new CountDownLatch(1);
+        BmwProbeGuard guard=new BmwProbeGuard(timers,0,reason->cancelled.countDown());
+        try {
+            assertEquals("Live session must not enqueue an expiry timer",0,timers.getQueue().size());
+            assertFalse(guard.isCancelled());
+            assertEquals("reply",guard.call("successful_rpc",1000,()->"reply"));
+            assertFalse(guard.isCancelled());
+            guard.cancel("stop");
+            assertTrue(cancelled.await(1,TimeUnit.SECONDS));
+            assertTrue(guard.isCancelled());
+        } finally {guard.cancel("cleanup");timers.shutdownNow();}
+    }
+    @Test public void localTestStillExpiresIndependently() throws Exception {
+        ScheduledExecutorService timers=Executors.newScheduledThreadPool(1);
+        CountDownLatch cancelled=new CountDownLatch(1);
+        java.util.concurrent.atomic.AtomicReference<String> reason=new java.util.concurrent.atomic.AtomicReference<>();
+        BmwProbeGuard guard=new BmwProbeGuard(timers,40,value->{reason.set(value);cancelled.countDown();});
+        try {
+            assertTrue(cancelled.await(1,TimeUnit.SECONDS));
+            assertEquals("session_deadline",reason.get());
+            assertTrue(guard.isCancelled());
+        } finally {guard.cancel("cleanup");timers.shutdownNow();}
+    }
+}

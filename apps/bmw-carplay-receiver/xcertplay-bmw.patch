+package com.shilapi.xcertplay.bmw;
+
+import java.util.HashMap;
+import java.util.Map;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class BmwDisplayLayoutTest {
+    private static Map<String, String> id4() {
+        Map<String, String> caps = new HashMap<>();
+        caps.put("hmi.type", "BMW ID4++");
+        return caps;
+    }
+    private static void assertClearOfNativeChrome(BmwDisplayLayout layout) {
+        assertEquals(0, layout.imageX);
+        assertEquals(0, layout.imageY);
+        assertEquals(layout.dimensions.getMarginLeft() + layout.dimensions.getPaddingLeft(), layout.nativeLeft);
+        assertEquals(layout.dimensions.getPaddingTop(), layout.nativeTop);
+        assertTrue(layout.nativeRight >= layout.dimensions.getMarginRight());
+        assertEquals(layout.dimensions.getRhmiWidth() - layout.nativeRight,
+                layout.nativeLeft + layout.canvasWidth);
+        assertEquals(layout.dimensions.getRhmiHeight(), layout.nativeTop + layout.canvasHeight);
+        assertEquals(0, layout.sourceWidth % 16);
+        assertEquals(0, layout.sourceHeight % 16);
+        assertTrue(layout.sourceWidth >= layout.canvasWidth && layout.sourceWidth - layout.canvasWidth < 16);
+        assertTrue(layout.sourceHeight >= layout.canvasHeight && layout.sourceHeight - layout.canvasHeight < 16);
+    }
+    @Test public void selectedWideProfileUsesCleanContentWithoutOverwritingCapabilities() {
+        Map<String, String> caps = id4();
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(caps, true);
+        assertEquals(1006, layout.canvasWidth);
+        assertEquals(400, layout.canvasHeight);
+        assertEquals(194, layout.nativeLeft);
+        assertEquals(80, layout.nativeTop);
+        assertEquals(80, layout.nativeRight);
+        assertEquals(1008, layout.sourceWidth);
+        assertEquals(400, layout.sourceHeight);
+        assertTrue(layout.usedWideProfile);
+        assertEquals("selected_wide_id4_profile", layout.widthBasis);
+        assertEquals("selected_wide_id4_profile", layout.heightBasis);
+        assertFalse(caps.containsKey("hmi.display-width"));
+        assertFalse(caps.containsKey("hmi.display-height"));
+        assertClearOfNativeChrome(layout);
+    }
+    @Test public void reportedNarrowScreenCannotBeEnlargedBySelectedProfile() {
+        Map<String, String> caps = id4();
+        caps.put("hmi.display-width", "800");caps.put("hmi.display-height", "480");
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(caps, true);
+        assertEquals(526, layout.canvasWidth);
+        assertEquals(400, layout.canvasHeight);
+        assertEquals(528, layout.sourceWidth);
+        assertFalse(layout.usedWideProfile);
+        assertEquals("reported_capability", layout.widthBasis);
+        assertClearOfNativeChrome(layout);
+    }
+    @Test public void disablingVehicleProfileRestoresConservativeDefault() {
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(id4(), false);
+        assertEquals(526, layout.canvasWidth);
+        assertEquals(400, layout.canvasHeight);
+        assertEquals("library_default", layout.widthBasis);
+        assertFalse(layout.usedWideProfile);
+        assertClearOfNativeChrome(layout);
+    }
+    @Test public void eachReportedAxisRemainsAuthoritative() {
+        Map<String, String> caps = id4();caps.put("hmi.display-height", "540");
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(caps, true);
+        assertEquals(1006, layout.canvasWidth);
+        assertEquals(460, layout.canvasHeight);
+        assertEquals(464, layout.sourceHeight);
+        assertEquals("selected_wide_id4_profile", layout.widthBasis);
+        assertEquals("reported_capability", layout.heightBasis);
+        assertClearOfNativeChrome(layout);
+    }
+    @Test public void profileDoesNotApplyToAnUnidentifiedOrDifferentHeadUnit() {
+        BmwDisplayLayout unidentified = BmwDisplayLayout.resolve(new HashMap<>(), true);
+        assertFalse(unidentified.usedWideProfile);
+        assertEquals(800, unidentified.dimensions.getRhmiWidth());
+        Map<String, String> caps = id4();caps.put("hmi.type", "MINI ID4");
+        BmwDisplayLayout mini = BmwDisplayLayout.resolve(caps, true);
+        assertFalse(mini.usedWideProfile);
+        assertEquals(800, mini.dimensions.getRhmiWidth());
+        assertEquals(mini.dimensions.getMarginRight(), mini.nativeRight);
+        assertEquals(unidentified.dimensions.getMarginRight(), unidentified.nativeRight);
+        assertClearOfNativeChrome(unidentified);assertClearOfNativeChrome(mini);
+    }
+    @Test public void reportedWideDimensionsPreserveUpstreamMargins() {
+        Map<String, String> caps = id4();
+        caps.put("hmi.display-width", "1280");caps.put("hmi.display-height", "480");
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(caps, false);
+        assertEquals(1006, layout.canvasWidth);
+        assertFalse(layout.usedWideProfile);
+        assertEquals("reported_capability", layout.heightBasis);
+        assertClearOfNativeChrome(layout);
+    }
+    @Test public void id4GutterAlsoProtectsReportedDimensionsWithoutWideProfile() {
+        Map<String, String> caps = id4();
+        caps.put("hmi.display-width", "1280");caps.put("hmi.display-height", "480");
+        BmwDisplayLayout layout = BmwDisplayLayout.resolve(caps, false);
+        assertEquals(1200, layout.nativeLeft + layout.canvasWidth);
+        assertEquals(80, layout.nativeRight);
+        assertFalse(layout.usedWideProfile);
+        assertEquals(2, BmwDisplayLayout.GEOMETRY_VERSION);
+    }
+    @Test public void explicitInvalidReportsAreRejectedRatherThanReplacedByProfile() {
+        for (String invalid : new String[]{"0", "-1", "wide", "9999999999999999", "10000"}) {
+            Map<String, String> caps = id4();caps.put("hmi.display-width", invalid);
+            assertThrows(IllegalArgumentException.class, () -> BmwDisplayLayout.resolve(caps, true));
+        }
+    }
+}

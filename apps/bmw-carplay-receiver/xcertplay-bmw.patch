+package com.shilapi.xcertplay.bmw
+
+import java.nio.file.Files
+import org.junit.Assert.*
+import org.junit.Test
+
+class BmwDiagnosticFilesTest {
+    @Test fun rotationRetainsOnlyThreeBoundedFilesAndLatestCompleteRecord() {
+        val directory = Files.createTempDirectory("bmw-health-test").toFile()
+        try {
+            val output = BmwDiagnosticFiles(directory, 128)
+            repeat(100) { output.append("{\"sample\":$it,\"numeric\":1234567890123456789}") }
+            assertEquals(3, directory.listFiles()!!.size)
+            assertTrue(directory.listFiles()!!.all { it.length() <= 128 })
+            assertTrue(directory.resolve("health.jsonl").readText().endsWith("{\"sample\":99,\"numeric\":1234567890123456789}\n"))
+        } finally { directory.deleteRecursively() }
+    }
+    @Test fun oversizedOrMultilineRecordCannotDisplaceExistingEvidence() {
+        val directory = Files.createTempDirectory("bmw-health-test").toFile()
+        try {
+            val output = BmwDiagnosticFiles(directory, 128)
+            output.append("{\"sample\":1}")
+            for (invalid in listOf("x".repeat(129), "line\nother")) {
+                try { output.append(invalid); fail("Expected rejection") } catch (_: IllegalArgumentException) { }
+            }
+            assertEquals("{\"sample\":1}\n", directory.resolve("health.jsonl").readText())
+        } finally { directory.deleteRecursively() }
+    }
+}

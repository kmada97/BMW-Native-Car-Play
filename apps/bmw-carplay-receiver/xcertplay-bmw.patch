--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/media/ReceiverHealthEvents.kt
@@ -0,0 +1,21 @@
+package com.shilapi.xcertplay.media
+
+/** Numeric metadata seam: cannot carry audio, identifiers, locations or credentials. */
+object ReceiverHealthEvents {
+    enum class Kind { AUDIO_RECEIVE, AUDIO_RENDER, VIDEO_DECODE }
+    enum class Metric {
+        TYPE, PACKETS, RECEIVED, DECRYPTED, AUTH_FAILURES, SHORT_PACKETS,
+        FORWARD_GAPS, REORDERED, DUPLICATES, LATE_OUTSIDE_WINDOW, WINDOW_PACKETS,
+        WINDOW_MS, MAX_ARRIVAL_GAP_US, FINAL, QUEUE, QUEUE_DROPPED, PENDING,
+        QUEUED, RETRIES, DROPPED, OUTPUTS, UNDERRUNS, CAPACITY_FRAMES, SIZE_FRAMES,
+        START_FRAMES, QUEUED_FRAMES, INPUTS, SYNC_SKIPS, MAX_OUTPUT_AGE_US, WAITING_FOR_SYNC,
+    }
+    data class Event(val kind: Kind, val elapsedMs: Long, val metrics: Map<Metric, Long>)
+    @Volatile var listener: ((Event) -> Unit)? = null
+
+    fun emit(kind: Kind, elapsedMs: Long, metrics: Map<Metric, Long>) {
+        val target = listener ?: return
+        // A diagnostics failure must never interrupt playback or the receive thread.
+        runCatching { target(Event(kind, elapsedMs, metrics.toMap())) }
+    }
+}

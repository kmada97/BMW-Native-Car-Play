+package com.shilapi.xcertplay.media
+
+import com.shilapi.xcertplay.airplay.VideoCodec
+import java.io.ByteArrayOutputStream
+import org.junit.Assert.*
+import org.junit.Test
+
+class VideoGeometryMetadataTest {
+    @Test fun parsesActualSpsCropAndPixelAspectIndependentlyOfRequestedSize() {
+        // Synthetic baseline SPS: coded1024x416, cropped1008x400, SAR4:3.
+        val parameters = VideoParameters.parse(VideoCodec.H264, syntheticSps(4, 3))
+        assertEquals(1008, parameters.width)
+        assertEquals(400, parameters.height)
+        assertEquals(4f / 3f, parameters.pixelWidthHeightRatio, 0.00001f)
+        val line = VideoGeometryMetadata.sps(parameters, 736, 480)
+        assertTrue(line.contains("width=1008 height=400 pixelAspect=1.3333334"))
+        assertTrue(line.contains("negotiatedWidth=736 negotiatedHeight=480"))
+        assertNumericFields(line, "video geometry sps ")
+    }
+
+    @Test fun absentSpsAspectRetainsSquarePixelDefault() {
+        val parameters = VideoParameters.parse(VideoCodec.H264, syntheticSps(null, null))
+        assertEquals(1f, parameters.pixelWidthHeightRatio, 0f)
+        assertEquals(1008, parameters.width)
+        assertEquals(400, parameters.height)
+    }
+
+    @Test fun decoderCropIsInclusiveAndDoesNotConfuseStrideWithVisibleWidth() {
+        val line = VideoGeometryMetadata.output(1024, 416, 0, 0, 1007, 399,
+            2048, 416, 1, 2, 3)
+        assertTrue(line.contains("width=1024 height=416"))
+        assertTrue(line.contains("cropRight=1007 cropBottom=399 visibleWidth=1008 visibleHeight=400"))
+        assertTrue(line.contains("stride=2048"))
+        assertNumericFields(line, "video geometry output ")
+    }
+
+    @Test fun noCropUsesOutputSizeWhileInvalidCropRemainsUnknown() {
+        val uncropped = VideoGeometryMetadata.output(1008, 400, null, null, null, null,
+            null, null, null, null, null)
+        assertTrue(uncropped.contains("visibleWidth=1008 visibleHeight=400"))
+        val invalid = VideoGeometryMetadata.output(1008, 400, 10, 0, 4, 400,
+            null, null, null, null, null)
+        assertTrue(invalid.contains("visibleWidth=-1 visibleHeight=-1"))
+        val unknown = VideoGeometryMetadata.output(null, null, null, null, null, null,
+            null, null, null, null, null)
+        assertTrue(unknown.contains("width=-1 height=-1"))
+        assertTrue(unknown.contains("visibleWidth=-1 visibleHeight=-1"))
+        assertNumericFields(uncropped, "video geometry output ")
+        assertNumericFields(invalid, "video geometry output ")
+        assertNumericFields(unknown, "video geometry output ")
+    }
+
+    @Test fun nonFiniteAspectCannotEscapeNumericLogAllowlist() {
+        for (aspect in listOf(Float.NaN, Float.POSITIVE_INFINITY, -1f, 0f)) {
+            val parameters = VideoParameters(1008, 400, -1, -1, -1, aspect)
+            val line = VideoGeometryMetadata.sps(parameters, 1008, 400)
+            assertTrue(line.contains("pixelAspect=-1.0"))
+            assertNumericFields(line, "video geometry sps ")
+        }
+    }
+
+    private fun assertNumericFields(line: String, prefix: String) {
+        assertTrue(line.startsWith(prefix))
+        line.removePrefix(prefix).split(' ').forEach {
+            assertTrue("Non-numeric metadata: $it", it.matches(Regex("[A-Za-z]+=-?[0-9]+(?:\\.[0-9]+)?(?:E-?[0-9]+)?")))
+        }
+    }
+
+    /** Builds a minimal test SPS; no captured phone/video payload is embedded. */
+    private fun syntheticSps(sarWidth: Int?, sarHeight: Int?): ByteArray {
+        val bits = mutableListOf<Int>()
+        fun fixed(value: Int, count: Int) { for (bit in count - 1 downTo 0) bits.add((value ushr bit) and 1) }
+        fun ue(value: Int) {
+            val code = value + 1
+            val count = 32 - Integer.numberOfLeadingZeros(code)
+            repeat(count - 1) { bits.add(0) };fixed(code, count)
+        }
+        fixed(66, 8);fixed(0, 8);fixed(30, 8) // Baseline profile, level3.
+        ue(0);ue(0);ue(0);ue(0);ue(1);fixed(0, 1)
+        ue(63);ue(25);fixed(1, 1);fixed(1, 1) // Coded1024x416, progressive.
+        fixed(1, 1);ue(0);ue(8);ue(0);ue(8) // Chroma420 crop units are2x2.
+        fixed(1, 1) // VUI present.
+        if (sarWidth != null && sarHeight != null) {
+            fixed(1, 1);fixed(255, 8);fixed(sarWidth, 16);fixed(sarHeight, 16)
+        } else fixed(0, 1)
+        repeat(8) { fixed(0, 1) } // Remaining optional VUI fields absent.
+        fixed(1, 1);while (bits.size % 8 != 0) fixed(0, 1)
+        val out = ByteArrayOutputStream()
+        out.write(byteArrayOf(0, 0, 0, 1, 0x67))
+        var zeros = 0
+        bits.chunked(8).forEach { octet ->
+            val byte = octet.fold(0) { a, b -> (a shl 1) or b }
+            if (zeros >= 2 && byte <= 3) { out.write(3);zeros = 0 }
+            out.write(byte);zeros = if (byte == 0) zeros + 1 else 0
+        }
+        return out.toByteArray()
+    }
+}

@@ -0,0 +1,21 @@
+package com.shilapi.xcertplay.bmw;
+
+/** Pure policy: no duplicate video sends, no test-frame autofocus, never steal focus back. */
+public final class BmwFramePolicy {
+    private long sentSequence=Long.MIN_VALUE;
+    private boolean focusConsumed;
+    private String waitingStatus;
+    public boolean shouldSend(long sequence,String source,boolean streamReady,boolean focused) {
+        boolean live="LIVE".equals(source)&&streamReady;
+        boolean test="DECODER_TEST".equals(source);
+        return sequence!=sentSequence && (focused&&(live||test)||!focusConsumed&&live);
+    }
+    public boolean shouldFocus(String source,boolean streamReady) {
+        return !focusConsumed&&"LIVE".equals(source)&&streamReady;
+    }
+    public void sent(long sequence) {sentSequence=sequence;waitingStatus=null;}
+    public void focusRequested() {focusConsumed=true;}
+    public void focused(boolean gained) {if(gained)focusConsumed=true;}
+    public boolean shouldShowWaiting(String status,boolean focused) {return focused&&!status.equals(waitingStatus);}
+    public void waitingShown(String status) {waitingStatus=status;sentSequence=Long.MIN_VALUE;}
+}

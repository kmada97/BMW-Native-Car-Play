+        if(frame==null)writer.println("latestFrame=none");
+        else {
+            String source="LIVE".equals(frame.getSource())?"LIVE":"DECODER_TEST".equals(frame.getSource())?"DECODER_TEST":"UNKNOWN";
+            writer.println("latestFrame source="+source+" sequence="+frame.getSequence()+" width="+frame.getWidth()+" height="+frame.getHeight()
+                +" ageMs="+Math.max(0,SystemClock.elapsedRealtime()-frame.getCapturedAtMs()));
+        }
+    }
+    @Override public boolean onUnbind(Intent intent){latestConnection=null;cancelNow("host_unbound");worker.post(()->close("host_unbound"));return true;}
+    @Override public void onRebind(Intent intent){accept(intent);}
+    @Override public void onDestroy(){BmwBridge.removeListener(bridgeListener);cancelNow("service_destroyed");worker.post(()->{close("service_destroyed");thread.quitSafely();timers.shutdown();});super.onDestroy();}
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwRuntimeTelemetry.kt b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwRuntimeTelemetry.kt
new file mode 100644
index 0000000..1a0d837
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwRuntimeTelemetry.kt
@@ -0,0 +1,101 @@
+package com.shilapi.xcertplay.bmw
+
+import android.content.Context
+import android.os.Build
+import android.os.PowerManager
+import android.os.Process
+import android.os.SystemClock
+import android.provider.Settings
+import com.shilapi.xcertplay.media.ReceiverHealthEvents
+import java.io.File
+import java.util.Locale
+import java.util.concurrent.ArrayBlockingQueue
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicLong
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** Low-rate, bounded on-device evidence; never changes clocks, cooling or audio settings. */
+internal object BmwRuntimeTelemetry {
+    private class Session(context: Context) {
+        val context = context.applicationContext
+        val startedMs = SystemClock.elapsedRealtime()
+        val bootCount = runCatching { Settings.Global.getInt(context.contentResolver, "boot_count", -1) }.getOrDefault(-1)
+        val events = ArrayBlockingQueue<ReceiverHealthEvents.Event>(32)
+        val lost = AtomicLong()
+        val files = BmwDiagnosticFiles(File(context.filesDir, "bmw-health"))
+        var future: ScheduledFuture<*>? = null
+        val callback: (ReceiverHealthEvents.Event) -> Unit = { if (!events.offer(it)) lost.incrementAndGet(); Unit }
+        var previousCpuMs = Process.getElapsedCpuTime()
+        var previousAtMs = startedMs
+        fun write(kind: String, atMs: Long, data: JSONObject) {
+            data.put("kind", kind).put("boot_elapsed_ms", atMs).put("boot_count", bootCount)
+                .put("telemetry_session_start_elapsed_ms", startedMs)
+            runCatching { files.append(data.toString()) }
+        }
+        fun drain() {
+            repeat(32) {
+                val item = events.poll() ?: return
+                val values = JSONObject()
+                item.metrics.forEach { (key, value) -> values.put(key.name.lowercase(Locale.ROOT), value) }
+                write(item.kind.name.lowercase(Locale.ROOT), item.elapsedMs, values)
+            }
+        }
+        fun sample() {
+            drain()
+            val at = SystemClock.elapsedRealtime()
+            val cpu = Process.getElapsedCpuTime()
+            val frame = BmwBridge.getLatestFrame()
+            val temperatures = JSONArray()
+            for (index in 0 until 8) {
+                val zone = File("/sys/class/thermal/thermal_zone$index")
+                if (!zone.exists()) continue
+                val type = readBounded(File(zone, "type"))?.takeIf { it.matches(Regex("[A-Za-z0-9_. -]{1,64}")) }
+                val value = readNumber(File(zone, "temp"))?.takeIf { it in -40_000..150_000 }
+                temperatures.put(JSONObject().put("zone", index).put("type", type ?: JSONObject.NULL)
+                    .put("millicelsius", value ?: JSONObject.NULL))
+            }
+            val pm = context.getSystemService(PowerManager::class.java)
+            val thermalStatus = if (Build.VERSION.SDK_INT >= 29) runCatching { pm.currentThermalStatus }.getOrNull() else null
+            val frequency = "/sys/devices/system/cpu/cpu0/cpufreq/"
+            write("health", at, JSONObject()
+                .put("window_ms", (at - previousAtMs).coerceAtLeast(0))
+                .put("app_cpu_ms", (cpu - previousCpuMs).coerceAtLeast(0))
+                .put("android_thermal_status", thermalStatus ?: JSONObject.NULL)
+                .put("thermal_zones", temperatures)
+                .put("cpu0_frequency_khz", readNumber(File(frequency + "scaling_cur_freq")) ?: JSONObject.NULL)
+                .put("cpu0_max_frequency_khz", readNumber(File(frequency + "scaling_max_freq")) ?: JSONObject.NULL)
+                .put("events_dropped", lost.get()).put("stream_ready", BmwBridge.isStreamReady())
+                .put("frame_sequence", frame?.sequence ?: JSONObject.NULL)
+                .put("frame_age_ms", frame?.let { (at - it.capturedAtMs).coerceAtLeast(0) } ?: JSONObject.NULL))
+            previousCpuMs = cpu; previousAtMs = at
+        }
+    }
+    private var session: Session? = null
+    private val executor = Executors.newSingleThreadScheduledExecutor { task ->
+        Thread(task, "bmw-health").apply { isDaemon = true }
+    }
+    @Synchronized fun start(context: Context) {
+        if (session != null) return
+        val next = Session(context); session = next
+        ReceiverHealthEvents.listener = next.callback
+        next.future = executor.scheduleWithFixedDelay({ runCatching { next.sample() } }, 0, 5, TimeUnit.SECONDS)
+    }
+    @Synchronized fun stop() {
+        val old = session ?: return
+        session = null
+        if (ReceiverHealthEvents.listener === old.callback) ReceiverHealthEvents.listener = null
+        old.future?.cancel(false)
+        executor.execute { old.drain() }
+    }
+    private fun readBounded(file: File): String? = runCatching {
+        file.inputStream().use { input ->
+            val bytes = ByteArray(128)
+            val count = input.read(bytes)
+            if (count in 1 until bytes.size) String(bytes, 0, count, Charsets.UTF_8).trim() else null
+        }
+    }.getOrNull()
+    private fun readNumber(file: File): Long? = readBounded(file)?.toLongOrNull()
+}

+package com.shilapi.xcertplay.bmw;
+
+import java.util.Arrays;
+import java.util.EnumMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Bounded scalar timing windows. RPC acknowledgment is not physical screen presentation. */
+public final class BmwLatencyWindow {
+    public enum Stage {
+        CAPTURE_TO_JPEG, JPEG_READY_TO_SEND, IMAGE_BEGIN, IMAGE_RPC,
+        CAPTURE_TO_RPC_ACK, RPC_COMPLETION_TO_WORKER, FRAME_ACK_GAP,
+        INPUT_TO_PHONE_ENQUEUE, INPUT_TO_BMW_ACK, INPUT_TO_NEW_SAMPLE_ACK
+    }
+    private static final int CAPACITY=256;
+    private static final class Window {
+        final double[] samples=new double[CAPACITY];
+        int size,next;
+        long count;
+        void add(double value){samples[next]=value;next=(next+1)%CAPACITY;size=Math.min(size+1,CAPACITY);count++;}
+        Map<String,Object> snapshot(){
+            double[] sorted=Arrays.copyOf(samples,size);Arrays.sort(sorted);
+            double sum=0;for(double value:sorted)sum+=value;
+            Map<String,Object> out=new LinkedHashMap<>();
+            out.put("session_count",count);out.put("window_count",size);
+            out.put("p50_ms",rounded(sorted[(size-1)/2]));
+            out.put("p95_ms",rounded(sorted[(int)Math.ceil(size*.95)-1]));
+            out.put("max_ms",rounded(sorted[size-1]));out.put("mean_ms",rounded(sum/size));
+            return out;
+        }
+    }
+    private final EnumMap<Stage,Window> windows=new EnumMap<>(Stage.class);
+    public synchronized void add(Stage stage,double milliseconds){
+        if(!Double.isFinite(milliseconds)||milliseconds<0)return;
+        Window window=windows.get(stage);
+        if(window==null){window=new Window();windows.put(stage,window);}
+        window.add(milliseconds);
+    }
+    public synchronized Map<String,Object> snapshot(){
+        Map<String,Object> out=new LinkedHashMap<>();
+        out.put("window_capacity",CAPACITY);
+        for(Map.Entry<Stage,Window> entry:windows.entrySet())out.put(entry.getKey().name(),entry.getValue().snapshot());
+        return out;
+    }
+    /** A frame already sampled before input cannot be its response, even if sent afterward. */
+    public static boolean sampledAfterInput(long capturedAtMs,long inputAtNs){
+        return inputAtNs>0&&capturedAtMs>=0&&capturedAtMs>=((inputAtNs+999999L)/1000000L);
+    }
+    private static double rounded(double value){return Math.round(value*10)/10.0;}
+}

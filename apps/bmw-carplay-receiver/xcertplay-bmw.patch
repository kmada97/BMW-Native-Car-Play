+package com.shilapi.xcertplay.bmw
+
+/** The BMW Pi 4 image exposes a simulated input, despite granting RECORD_AUDIO. */
+internal object BmwMicrophonePolicy {
+    /**
+     * Permission and an enumerated Built-In Mic are insufficient on this profile.
+     * Only a separately verified real capture path may opt it back in. This does not
+     * select an iPhone call route or imply access to the BMW microphone.
+     */
+    fun canAdvertise(
+        permissionGranted: Boolean,
+        bmwEnabled: Boolean,
+        device: String,
+        hardware: String,
+        verifiedRealInput: Boolean = false,
+    ): Boolean {
+        if (!permissionGranted) return false
+        val knownPi4 = device.trim().equals("rpi4", ignoreCase = true) ||
+            hardware.trim().equals("rpi4", ignoreCase = true)
+        return !bmwEnabled || !knownPi4 || verifiedRealInput
+    }
+}

+package com.shilapi.xcertplay.bmw;
+
+import java.util.Map;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class BmwLatencyWindowTest {
+    @SuppressWarnings("unchecked") private Map<String,Object> stage(BmwLatencyWindow p,BmwLatencyWindow.Stage stage){
+        return (Map<String,Object>)p.snapshot().get(stage.name());
+    }
+    @Test public void reportsBoundedRecentWindowAndSeparateSessionCount(){
+        BmwLatencyWindow p=new BmwLatencyWindow();
+        for(int i=1;i<=300;i++)p.add(BmwLatencyWindow.Stage.IMAGE_RPC,i);
+        Map<String,Object> s=stage(p,BmwLatencyWindow.Stage.IMAGE_RPC);
+        assertEquals(300L,s.get("session_count"));assertEquals(256,s.get("window_count"));
+        assertEquals(172.0,s.get("p50_ms"));assertEquals(288.0,s.get("p95_ms"));assertEquals(300.0,s.get("max_ms"));
+    }
+    @Test public void invalidTimingsCannotPolluteOtherStages(){
+        BmwLatencyWindow p=new BmwLatencyWindow();
+        for(double invalid:new double[]{-1,Double.NaN,Double.POSITIVE_INFINITY})p.add(BmwLatencyWindow.Stage.IMAGE_RPC,invalid);
+        assertFalse(p.snapshot().containsKey("IMAGE_RPC"));
+        p.add(BmwLatencyWindow.Stage.INPUT_TO_BMW_ACK,7.44);
+        assertEquals(7.4,stage(p,BmwLatencyWindow.Stage.INPUT_TO_BMW_ACK).get("mean_ms"));
+    }
+    @Test public void staleFrameCannotBecomeInputResponseBecauseItsSendWasLater(){
+        assertFalse(BmwLatencyWindow.sampledAfterInput(99,100000000L));
+        assertFalse(BmwLatencyWindow.sampledAfterInput(100,100000001L));
+        assertTrue(BmwLatencyWindow.sampledAfterInput(101,100000001L));
+        assertFalse(BmwLatencyWindow.sampledAfterInput(101,0));
+    }
+}

@@ -0,0 +1,23 @@
+package com.shilapi.xcertplay.bmw
+
+import java.io.File
+import java.io.FileOutputStream
+
+/** One serial owner; close each write so logs remain readable after a USB host change. */
+internal class BmwDiagnosticFiles(private val directory: File, private val maxBytes: Int = 256 * 1024) {
+    init { require(maxBytes >= 128) }
+    fun append(line: String) {
+        val bytes = (line + "\n").toByteArray(Charsets.UTF_8)
+        require(bytes.size <= maxBytes && !line.contains('\n'))
+        check(directory.isDirectory || directory.mkdirs())
+        val current = File(directory, "health.jsonl")
+        if (current.length() + bytes.size > maxBytes) {
+            val oldest = File(directory, "health.2.jsonl")
+            check(!oldest.exists() || oldest.delete())
+            val previous = File(directory, "health.1.jsonl")
+            check(!previous.exists() || previous.renameTo(oldest))
+            check(!current.exists() || current.renameTo(previous))
+        }
+        FileOutputStream(current, true).use { it.write(bytes) }
+    }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwDisplayLayout.java b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwDisplayLayout.java

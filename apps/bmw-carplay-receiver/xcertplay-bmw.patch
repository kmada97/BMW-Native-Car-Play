@@ -0,0 +1,25 @@
+package com.shilapi.xcertplay.bmw
+
+/** Main-thread gate for automatic navigation; background lifecycle callbacks cannot take focus. */
+internal class ForegroundLaunchGate {
+    private var pending = false
+    private var resumed = false
+    private var focused = false
+    private var closed = false
+
+    fun request() { if (!closed) pending = true }
+    fun resume() { resumed = true }
+    fun focus(value: Boolean) { focused = value }
+    fun pause() { resumed = false; focused = false }
+    fun close() { closed = true; pending = false; pause() }
+    fun consume(): Boolean {
+        if (closed || !pending || !resumed || !focused) return false
+        pending = false
+        return true
+    }
+}
+
+internal object BmwBootPolicy {
+    fun shouldLaunch(autoStart: Boolean, selectedHomePackage: String?, ownPackage: String): Boolean =
+        autoStart && selectedHomePackage != ownPackage
+}

@@ -0,0 +1,18 @@
+package com.shilapi.xcertplay.bmw
+
+/** BMW owns negotiated geometry; its receiver need not wait for an HDMI preview surface. */
+internal object BmwStartupPolicy {
+    fun initialSize(
+        preview: Pair<Int, Int>?,
+        bmwEnabled: Boolean,
+        configuredProjection: Pair<Int, Int>?,
+    ): Pair<Int, Int>? {
+        if (preview != null && preview.first > 0 && preview.second > 0) return preview
+        return configuredProjection?.takeIf {
+            bmwEnabled && it.first in 200..2048 && it.second in 200..1024
+        }
+    }
+
+    fun previewDebounceMs(bmwEnabled: Boolean, declaredRotation: Boolean): Long =
+        if (bmwEnabled || declaredRotation) 0L else 500L
+}

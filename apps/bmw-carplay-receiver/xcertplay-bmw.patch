+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwCapturePolicy.kt
@@ -0,0 +1,88 @@
+package com.shilapi.xcertplay.bmw
+
+/** Small, process-local feedback loop. Only timings/counts cross the BMW transport seam. */
+internal class BmwCapturePolicy {
+    private var interactionUntilMs = 0L
+    private var transferMs = 0.0
+    private var transferBytes = 0
+    private var duplicateSamples = 0L
+    private var refinementEncodes = 0L
+
+    @Synchronized fun interaction(nowMs: Long) {
+        interactionUntilMs = nowMs + 700
+    }
+
+    @Synchronized fun transferred(durationMs: Long, bytes: Int) {
+        if (durationMs < 0 || bytes <= 0) return
+        // Bound outliers, and recover gradually rather than alternating quality every frame.
+        val sample = durationMs.coerceAtMost(8000).toDouble()
+        transferMs = if (transferBytes == 0) sample else transferMs * .75 + sample * .25
+        transferBytes = bytes
+    }
+
+    @Synchronized fun intervalMs(nowMs: Long): Long = if (nowMs < interactionUntilMs)
+        (transferMs / 4).toLong().coerceIn(67,100)
+    else (transferMs / 2).toLong().coerceIn(100,200)
+
+    @Synchronized fun jpegQuality(nowMs: Long): Int {
+        val transportQuality = when {
+            transferMs >= 400 -> 20
+            transferMs >= 250 -> 25
+            transferMs >= 150 -> 30
+            else -> 40
+        }
+        return if (nowMs < interactionUntilMs) minOf(30, transportQuality) else transportQuality
+    }
+
+    @Synchronized fun interactionUntilMs(): Long = interactionUntilMs
+    @Synchronized fun duplicateSample() { duplicateSamples++ }
+    @Synchronized fun refinementEncoded() { refinementEncodes++ }
+
+    @Synchronized fun summary(nowMs: Long): String =
+        "captureIntervalMs=${intervalMs(nowMs)} jpegQuality=${jpegQuality(nowMs)} " +
+            "transferEwmaMs=${transferMs.toLong()} lastTransferBytes=$transferBytes " +
+            "pixelDuplicateSamples=$duplicateSamples refinementJpegs=$refinementEncodes"
+}
+
+/** One clearer copy after real pixels settle; repeated identical decoder frames never rearm it. */
+internal class BmwStillFramePolicy {
+    enum class Pass { NONE, MOTION, REFINE }
+    companion object {
+        // Longer than a one-second progress/clock tick: those are still moving screens.
+        const val SETTLE_MS = 1200L
+        const val REFINEMENT_QUALITY = 65
+    }
+    private var changedAtMs: Long? = null
+    private var refined = false
+
+    fun decide(pixelsChanged: Boolean, nowMs: Long, interactionUntilMs: Long): Pass {
+        if (pixelsChanged) {
+            changedAtMs = nowMs
+            refined = false
+            return Pass.MOTION
+        }
+        if (nextDelayMs(nowMs, interactionUntilMs) == 0L) {
+            refined = true
+            return Pass.REFINE
+        }
+        return Pass.NONE
+    }
+
+    fun nextDelayMs(nowMs: Long, interactionUntilMs: Long): Long? {
+        val changedAt = changedAtMs ?: return null
+        return if (refined) null else (maxOf(changedAt + SETTLE_MS, interactionUntilMs) - nowMs).coerceAtLeast(0)
+    }
+    fun reset() { changedAtMs = null; refined = false }
+}
+
+/** Retains a dirty latest texture until its deadline, including the last frame of an animation. */
+internal class BmwCaptureSchedule {
+    private var dirty = false
+    private var lastCaptureMs: Long? = null
+
+    fun decoded() { dirty = true }
+    fun delayMs(nowMs: Long, intervalMs: Long): Long? = if (!dirty) null else
+        lastCaptureMs?.let { (it + intervalMs - nowMs).coerceAtLeast(0) } ?: 0L
+    fun captured(nowMs: Long) { dirty = false; lastCaptureMs = nowMs }
+    fun reset() { dirty = false; lastCaptureMs = null }
+}

+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwCertificates.java
@@ -0,0 +1,66 @@
+package com.shilapi.xcertplay.bmw;
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStreamReader;
+import java.io.StringWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import org.bouncycastle.asn1.x500.RDN;
+import org.bouncycastle.asn1.x500.style.BCStyle;
+import org.bouncycastle.cert.X509CertificateHolder;
+import org.bouncycastle.cms.CMSSignedData;
+import org.bouncycastle.util.CollectionStore;
+import org.bouncycastle.util.io.pem.PemObject;
+import org.bouncycastle.util.io.pem.PemReader;
+import org.bouncycastle.util.io.pem.PemWriter;
+
+/** BMW certificate-chain assembly, adapted from MIT-licensed IDriveConnectKitAndroid.
+ * Uses the receiver's current BouncyCastle; never loads the legacy 1.46 crypto provider.
+ * This is BMW Apps transport authentication, independent of iPhone CarPlay authentication.
+ */
+public final class BmwCertificates {
+    private BmwCertificates() {}
+
+    static CMSSignedData parse(byte[] bytes) throws Exception {
+        if (bytes == null || bytes.length == 0) throw new IllegalArgumentException("Empty BMW certificate");
+        String prefix = new String(bytes, 0, Math.min(bytes.length, 80), StandardCharsets.US_ASCII);
+        if (prefix.contains("-----BEGIN")) {
+            try (PemReader reader = new PemReader(new InputStreamReader(
+                    new ByteArrayInputStream(bytes), StandardCharsets.US_ASCII))) {
+                PemObject object = reader.readPemObject();
+                if (object == null) throw new IllegalArgumentException("Invalid BMW PEM certificate");
+                return new CMSSignedData(object.getContent());
+            }
+        }
+        return new CMSSignedData(bytes);
+    }
+
+    static String commonName(X509CertificateHolder cert) {
+        RDN[] names = cert.getSubject().getRDNs(BCStyle.CN);
+        return names.length == 0 ? "" : names[0].getFirst().getValue().toString();
+    }
+
+    public static byte[] mergeBMWCert(byte[] appBytes, byte[] bmwBytes) throws Exception {
+        CMSSignedData app = parse(appBytes), bmw = parse(bmwBytes);
+        List<X509CertificateHolder> combined = new ArrayList<>();
+        for (X509CertificateHolder cert : app.getCertificates().getMatches(null)) {
+            if (!"a4a_root-ca".equals(commonName(cert))) combined.add(cert);
+        }
+        boolean hasConnection = false;
+        for (X509CertificateHolder cert : bmw.getCertificates().getMatches(null)) {
+            if (commonName(cert).toLowerCase(Locale.ROOT).contains("connection")) {
+                combined.add(cert); hasConnection = true;
+            }
+        }
+        if (!hasConnection) throw new IllegalArgumentException("BMW connection certificate missing");
+        CMSSignedData merged = CMSSignedData.replaceCertificatesAndCRLs(app,
+                new CollectionStore<>(combined), app.getAttributeCertificates(), app.getCRLs());
+        StringWriter text = new StringWriter();
+        try (PemWriter writer = new PemWriter(text)) {
+            writer.writeObject(new PemObject("PKCS7", merged.getEncoded()));
+        }
+        return text.toString().getBytes(StandardCharsets.US_ASCII);
+    }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwCheckpointActivity.kt b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwCheckpointActivity.kt

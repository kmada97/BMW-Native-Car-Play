@@ -0,0 +1,244 @@
+package com.shilapi.xcertplay.bmw
+
+import android.content.Context
+import android.os.SystemClock
+import android.util.Log
+import android.view.Surface
+import com.shilapi.xcertplay.airplay.AirPlayConfig
+import com.shilapi.xcertplay.media.AndroidMediaSink
+import com.shilapi.xcertplay.orchestration.CarPlayController
+import java.io.Closeable
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArraySet
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+/** Process-local receiver/BMW seam. No network/decoder work ever executes in a frame listener. */
+object BmwBridge {
+    const val MAIN = 110
+    const val LIVE = "LIVE"
+    const val DECODER_TEST = "DECODER_TEST"
+    data class Frame(val sequence: Long, val width: Int, val height: Int, val jpeg: ByteArray, val source: String, val capturedAtMs: Long, val encodedAtMs: Long)
+    private val latest = LatestFrameSlot<Frame>()
+    private val listeners = CopyOnWriteArraySet<Runnable>()
+    private val sessions = ConcurrentHashMap<AndroidMediaSink, CaptureSession>()
+    private val sequence = AtomicLong()
+    private val lock = Any()
+    private val capturePolicy = BmwCapturePolicy()
+    @Volatile private var enabled = false
+    @Volatile private var active: CaptureSession? = null
+    @Volatile private var target = BmwVideoGeometry.WIDTH to BmwVideoGeometry.HEIGHT
+    @Volatile private var projectionSize = BmwVideoGeometry.SOURCE_WIDTH to BmwVideoGeometry.SOURCE_HEIGHT
+    @Volatile private var status = "BMW receiver bridge is off"
+    @Volatile private var test: BmwDecoderTest? = null
+
+    @JvmStatic fun setEnabled(value: Boolean) {
+        enabled = value
+        if (!value) stop() else { status="Waiting for authenticated iPhone video";notifyChanged() }
+    }
+    @JvmStatic fun isEnabled(): Boolean = enabled
+    @JvmStatic fun getLatestFrame(): Frame? = latest.latest()
+    @JvmStatic fun addListener(listener: Runnable) { listeners.add(listener) }
+    @JvmStatic fun removeListener(listener: Runnable) { listeners.remove(listener) }
+    @JvmStatic fun statusText(): String = status
+    @JvmStatic fun configuredProjectionSize(): Pair<Int,Int> = projectionSize
+    @JvmStatic fun isStreamReady(): Boolean {
+        val session=active ?: return false
+        val frame=latest.latest() ?: return false
+        return enabled && session.source==LIVE && session.streamActive && frame.source==LIVE &&
+            session.controller?.isProjectionInputReady()==true && !session.closed.get()
+    }
+    @JvmStatic fun setTargetSize(width:Int,height:Int) {
+        if(!BmwVideoGeometry.valid(width,height))return
+        target=width to height;active?.capture?.setTargetSize(width,height)
+    }
+    /** Restore the last clean car canvas before phone negotiation, independently of HDMI size. */
+    @JvmStatic fun configureDisplay(context:Context) {
+        BmwRuntimeTelemetry.start(context)
+        val prefs=context.getSharedPreferences("bmw_bridge",Context.MODE_PRIVATE)
+        val wide=prefs.getBoolean(BmwDisplayLayout.WIDE_PROFILE_PREFERENCE,true)
+        val fallback=BmwDisplayLayout.resolve(mapOf("hmi.type" to "BMW ID4++"),wide)
+        val sameProfile=prefs.getInt("geometry_version",0)==BmwDisplayLayout.GEOMETRY_VERSION &&
+            prefs.contains("last_wide_profile") && prefs.getBoolean("last_wide_profile",false)==wide
+        val width=if(sameProfile)prefs.getInt("canvas_width",fallback.canvasWidth) else fallback.canvasWidth
+        val height=if(sameProfile)prefs.getInt("canvas_height",fallback.canvasHeight) else fallback.canvasHeight
+        if(BmwVideoGeometry.valid(width,height)) {
+            projectionSize=((width+15) and -16) to ((height+15) and -16)
+            setTargetSize(width,height)
+        } else {
+            projectionSize=fallback.sourceWidth to fallback.sourceHeight
+            setTargetSize(fallback.canvasWidth,fallback.canvasHeight)
+        }
+        prefs.edit().putBoolean(BmwDisplayLayout.WIDE_PROFILE_PREFERENCE,wide).apply()
+    }
+    @JvmStatic fun applyDisplayLayout(context:Context,layout:BmwDisplayLayout) {
+        projectionSize=layout.sourceWidth to layout.sourceHeight
+        setTargetSize(layout.canvasWidth,layout.canvasHeight)
+        val prefs=context.getSharedPreferences("bmw_bridge",Context.MODE_PRIVATE)
+        prefs.edit().putInt("canvas_width",layout.canvasWidth).putInt("canvas_height",layout.canvasHeight)
+            .putInt("geometry_version",BmwDisplayLayout.GEOMETRY_VERSION)
+            .putBoolean("last_wide_profile",prefs.getBoolean(BmwDisplayLayout.WIDE_PROFILE_PREFERENCE,true)).apply()
+    }
+    @JvmStatic fun sendKnob(direction:Int,pressed:Boolean):Boolean {
+        if(!isStreamReady())return false
+        val forwarded=active?.controller?.sendKnob(direction.coerceIn(-1,1),pressed) ?: false
+        if(forwarded)noteInteraction()
+        return forwarded
+    }
+    @JvmStatic fun noteInteraction() { capturePolicy.interaction(SystemClock.elapsedRealtime()) }
+    @JvmStatic fun noteFrameTransfer(rpcMs:Long,bytes:Int) { capturePolicy.transferred(rpcMs,bytes) }
+    @JvmStatic fun capturePolicySummary():String = capturePolicy.summary(SystemClock.elapsedRealtime())
+    @JvmStatic fun sendCarPlayHome():Boolean = if(isStreamReady())active?.controller?.sendKnobHome() ?: false else false
+    @JvmStatic fun sendCarPlayBack():Boolean = if(isStreamReady())active?.controller?.sendKnobBack() ?: false else false
+
+    /** Fixed car geometry; HDMI/Activity resizing cannot silently renegotiate the BMW projection. */
+    fun receiverConfig(config:AirPlayConfig):AirPlayConfig {
+        if(!enabled)return config
+        val size=projectionSize
+        return config.copy(
+        main=BmwAirPlayGeometry.mainDisplay(config.main,size.first,size.second),hevc=false,
+        )
+    }
+    fun createSession(width:Int,height:Int):CaptureSession? {
+        if(!enabled)return null
+        stopDecoderTest()
+        return CaptureSession(width,height,LIVE)
+    }
+    fun adoptSession(sink:AndroidMediaSink,controller:CarPlayController,mainActive:Boolean) {
+        if(!enabled)return
+        val session=sessions[sink] ?: createSession(controller.mainDisplay.widthPixels,controller.mainDisplay.heightPixels)?.also { it.bind(sink) } ?: return
+        attachController(sink,controller)
+        if(mainActive&&!session.streamActive)session.onStreamActive(MAIN,true)
+    }
+    fun streamActive(sink:AndroidMediaSink?,type:Int,active:Boolean) {
+        sink?.let(sessions::get)?.onStreamActive(type,active)
+    }
+    fun releaseSession(sink:AndroidMediaSink?) { sink?.let(sessions::get)?.close() }
+    fun attachController(sink:AndroidMediaSink,controller:CarPlayController) {
+        val session=sessions[sink] ?: return
+        session.controller=controller
+        controller.setProjectionStateListener { ready ->
+            if(active===session&&!session.closed.get()) {
+                if(!ready)session.onStreamActive(MAIN,false)
+                notifyChanged()
+            }
+        }
+        notifyChanged()
+    }
+    fun preview(sink:AndroidMediaSink?,type:Int,surface:Surface?):Boolean {
+        if(type!=MAIN)return false
+        val session=sink?.let(sessions::get) ?: return false
+        if(session.closed.get())return false
+        session.capture.setPreview(surface);return true
+    }
+    @JvmStatic fun stop() {
+        enabled=false
+        BmwRuntimeTelemetry.stop()
+        stopDecoderTest()
+        sessions.values.toSet().forEach { it.close() }
+        synchronized(lock) { active=null;latest.reset();status="BMW receiver bridge is off" }
+        notifyChanged()
+    }
+    @JvmStatic fun startDecoderTest(context:Context):Boolean = synchronized(lock) {
+        if(isStreamReady())return false
+        test?.close()
+        enabled=true
+        status="LOCAL VIDEO TEST — no phone; starting decoder"
+        val next=BmwDecoderTest(context.applicationContext)
+        test=next;next.start();notifyChanged();true
+    }
+    @JvmStatic fun stopDecoderTest() {
+        val old=synchronized(lock) { val value=test;test=null;value }
+        old?.close()
+    }
+    private fun notifyChanged() { listeners.forEach { listener -> runCatching { listener.run() } } }
+
+    class CaptureSession internal constructor(width:Int,height:Int,val source:String,private val testOwner:BmwDecoderTest?=null):Closeable {
+        internal val closed=AtomicBoolean(false)
+        @Volatile internal var streamActive=false
+        @Volatile internal var controller:CarPlayController?=null
+        @Volatile private var sink:AndroidMediaSink?=null
+        @Volatile private var inputSurface:Surface?=null
+        @Volatile private var token=latest.token()
+        internal val capture=BmwEglCapture(width,height,capturePolicy,
+            onSurface={ surface ->
+                synchronized(lock) {
+                    if(!closed.get()&&active===this) {
+                        inputSurface=surface
+                        sink?.setSurface(MAIN,surface)
+                    }
+                }
+            },
+            onJpeg={ w,h,jpeg,generation,capturedAtMs ->
+                val published=synchronized(lock) {
+                    if(!closed.get()&&streamActive&&active===this&&enabled&&latest.publish(generation,
+                        Frame(sequence.incrementAndGet(),w,h,jpeg,source,capturedAtMs,SystemClock.elapsedRealtime()))) {
+                        status=if(source==LIVE)"Live iPhone video decoded; BMW frame ready" else "LOCAL VIDEO TEST — no phone"
+                        true
+                    } else false
+                }
+                if(published)notifyChanged()
+            },
+            onError={ message ->
+                Log.w("BmwReceiverBridge",message)
+                val changed=synchronized(lock) {
+                    if(active===this&&!closed.get()) {
+                        streamActive=false;status=message;latest.reset()
+                        inputSurface?.let { sink?.clearSurface(MAIN,it) }
+                        true
+                    } else false
+                }
+                if(changed)notifyChanged()
+            },
+        )
+        fun bind(sink:AndroidMediaSink):Boolean {
+            synchronized(lock) {
+                if(closed.get() || !enabled || (source==DECODER_TEST && test!==testOwner)) { close();return false }
+                this.sink=sink
+                sessions[sink]=this
+                active?.takeIf { it!==this }?.close()
+                active=this;token=latest.reset()
+            }
+            capture.setTargetSize(target.first,target.second)
+            capture.start()
+            return true
+        }
+        fun onStreamActive(type:Int,value:Boolean) {
+            if(type!=MAIN||closed.get())return
+            synchronized(lock) {
+                if(active!==this||closed.get())return
+                streamActive=value;token=latest.reset()
+                status=if(value) { if(source==LIVE)"iPhone video active; waiting for decoded frame" else "LOCAL VIDEO TEST — no phone" }
+                    else if(source==LIVE)"iPhone video stopped; waiting for reconnect" else "Local video test stopped"
+                capture.setActive(value,token)
+            }
+            notifyChanged()
+        }
+        override fun close() {
+            if(!closed.compareAndSet(false,true))return
+            streamActive=false
+            val oldController=controller;controller=null
+            oldController?.setProjectionStateListener(null)
+            synchronized(lock) {
+                val current=sink
+                if(current!=null) { sessions.remove(current,this);inputSurface?.let { current.clearSurface(MAIN,it) } }
+                sink=null
+                if(active===this) { active=null;latest.reset();status="Waiting for authenticated iPhone video" }
+            }
+            capture.close()
+            notifyChanged()
+        }
+    }
+
+    internal fun newTestSession(owner:BmwDecoderTest,width:Int,height:Int)=CaptureSession(width,height,DECODER_TEST,owner)
+    internal fun finishDecoderTest(owner:BmwDecoderTest,failure:String?) {
+        val changed=synchronized(lock) {
+            if(test!==owner)false else {
+                test=null
+                status=if(failure==null)"Local video test finished — no phone" else "Local decoder test failed: $failure"
+                true
+            }
+        }
+        if(changed)notifyChanged()
+    }
+}

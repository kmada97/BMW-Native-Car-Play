@@ -0,0 +1,22 @@
+package com.shilapi.xcertplay.bmw;
+
+/** Pure translation; phone input is queued before any blocking BMW image/control RPC. */
+public final class BmwInputPolicy {
+    public enum Kind { NONE, ROTATE, PRESS }
+    public static final class Input {
+        public final Kind kind;
+        public final int direction;
+        private Input(Kind kind,int direction){this.kind=kind;this.direction=direction;}
+        public boolean forwards(){return kind!=Kind.NONE;}
+    }
+    private static final Input NONE=new Input(Kind.NONE,0), PRESS=new Input(Kind.PRESS,0);
+    private final int selectAction,clickAction;
+    public BmwInputPolicy(int selectAction,int clickAction){this.selectAction=selectAction;this.clickAction=clickAction;}
+    public Input decode(int action,Object row,Object invoked) {
+        if(action==selectAction&&row instanceof Number){
+            int index=((Number)row).intValue();
+            if(index>=0&&index<=6&&index!=3)return new Input(Kind.ROTATE,index<3?-1:1);
+        }else if(action==clickAction&&!(invoked instanceof Number&&((Number)invoked).intValue()==2))return PRESS;
+        return NONE;
+    }
+}

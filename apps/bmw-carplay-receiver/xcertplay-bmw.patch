@@ -0,0 +1,18 @@
+package com.shilapi.xcertplay.bmw;
+
+/** Latest-only transfer counters. The one-flight async sender supplies backpressure. */
+public final class BmwSenderPolicy {
+    private long frames,bytes,lastRpcMs,maxRpcMs,totalRpcMs,skippedSequences,lastSequence=-1;
+    public long delayMs(long nowMs){return 0;}
+    public synchronized void transferred(long completedMs,long rpcMs,int byteCount,long sequence){
+        lastRpcMs=Math.max(0,rpcMs);maxRpcMs=Math.max(maxRpcMs,lastRpcMs);totalRpcMs+=lastRpcMs;
+        frames++;bytes+=Math.max(0,byteCount);
+        if(lastSequence>=0&&sequence>lastSequence)skippedSequences+=Math.max(0,sequence-lastSequence-1);
+        lastSequence=sequence;
+        // Native ACK/recenter work is prioritized explicitly. No artificial post-response gap.
+    }
+    public synchronized String summary(){
+        return "sentFrames="+frames+" sentBytes="+bytes+" lastRpcMs="+lastRpcMs+" maxRpcMs="+maxRpcMs+
+            " meanRpcMs="+(frames==0?0:totalRpcMs/frames)+" supersededFrames="+skippedSequences;
+    }
+}

+package com.shilapi.xcertplay.bmw;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class BmwFramePolicyTest {
+    @Test public void onlyFirstLiveSessionCanAutoOpen() {
+        BmwFramePolicy p=new BmwFramePolicy();
+        assertFalse(p.shouldSend(1,"DECODER_TEST",false,false));
+        assertFalse(p.shouldFocus("DECODER_TEST",false));
+        assertFalse(p.shouldSend(2,"LIVE",false,false));
+        assertFalse(p.shouldFocus("LIVE",false));
+        assertTrue(p.shouldSend(3,"LIVE",true,false));
+        assertTrue(p.shouldFocus("LIVE",true));
+        p.sent(3);p.focusRequested();
+        assertFalse(p.shouldSend(3,"LIVE",true,true));
+        assertTrue(p.shouldSend(4,"LIVE",true,true));
+        assertFalse(p.shouldFocus("LIVE",true));
+        p.focused(false);
+        assertFalse(p.shouldSend(5,"LIVE",true,false));
+        assertFalse(p.shouldFocus("LIVE",true));
+    }
+    @Test public void manualEntryThenBackCannotBeOverriddenByLaterAuthentication() {
+        BmwFramePolicy p=new BmwFramePolicy();
+        assertFalse(p.shouldShowWaiting("Waiting",false));
+        p.focused(true);
+        assertTrue(p.shouldShowWaiting("Waiting",true));p.waitingShown("Waiting");
+        assertFalse(p.shouldShowWaiting("Waiting",true));
+        assertTrue(p.shouldShowWaiting("Authentication unavailable",true));
+        assertTrue(p.shouldSend(1,"DECODER_TEST",false,true));p.sent(1);
+        assertFalse(p.shouldSend(1,"DECODER_TEST",false,true));
+        p.focused(false);
+        assertFalse(p.shouldFocus("LIVE",true));
+        assertFalse(p.shouldSend(2,"LIVE",true,false));
+        p.focused(true);assertTrue(p.shouldSend(2,"LIVE",true,true));
+    }
+    @Test public void stopOrUnknownFramesNeverPretendToBeLive() {
+        BmwFramePolicy p=new BmwFramePolicy();p.focused(true);
+        assertFalse(p.shouldSend(1,"LIVE",false,true));
+        assertFalse(p.shouldSend(1,"UNKNOWN",true,true));
+        assertFalse(p.shouldSend(1,"WAITING_STATUS",true,true));
+        assertTrue(p.shouldSend(2,"LIVE",true,true));p.sent(2);
+        p.waitingShown("Disconnected");
+        assertTrue(p.shouldSend(2,"LIVE",true,true)); // waiting image replaced last live image
+    }
+}

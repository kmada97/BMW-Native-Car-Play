@@ -0,0 +1,50 @@
+package com.shilapi.xcertplay
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ActivityRetryOwnerTest {
+    @Test fun destroyedActivityCannotRestartAnAdoptedController() {
+        val queued = mutableListOf<Runnable>()
+        val removed = mutableListOf<Runnable>()
+        var controllerRestarts = 0
+        val old = ActivityRetryOwner({ task, _ -> queued.add(task) }, removed::add)
+        assertTrue(old.schedule(2000) { controllerRestarts++ })
+        val stale = queued.single()
+        old.close()
+        assertEquals(listOf(stale), removed)
+        // Even if a callback escaped Handler removal it cannot close the adopted session.
+        stale.run()
+        assertFalse(old.schedule(2000) { controllerRestarts++ })
+        val replacement = ActivityRetryOwner({ task, _ -> queued.add(task) }, removed::add)
+        assertTrue(replacement.schedule(2000) { controllerRestarts++ })
+        queued.last().run()
+        assertEquals(1, controllerRestarts)
+        assertFalse(replacement.isPending)
+    }
+
+    @Test fun cancelInvalidatesOldCallbackWithoutBlockingNextRetry() {
+        val queued = mutableListOf<Runnable>()
+        var restarts = 0
+        val owner = ActivityRetryOwner({ task, _ -> queued.add(task) }, {})
+        owner.schedule(2000) { restarts += 100 }
+        val stale = queued.single()
+        owner.cancel()
+        assertTrue(owner.schedule(4000) { restarts++ })
+        stale.run()
+        assertTrue(owner.isPending)
+        queued.last().run()
+        queued.last().run()
+        assertEquals(1, restarts)
+    }
+
+    @Test fun repeatedFailuresCoalesceUntilScheduledRetryRuns() {
+        val queued = mutableListOf<Pair<Runnable, Long>>()
+        val owner = ActivityRetryOwner({ task, delay -> queued.add(task to delay) }, {})
+        assertTrue(owner.schedule(8000) {})
+        assertFalse(owner.schedule(16000) {})
+        assertEquals(8000L, queued.single().second)
+        queued.single().first.run()
+        assertTrue(owner.schedule(16000) {})
+    }
+}

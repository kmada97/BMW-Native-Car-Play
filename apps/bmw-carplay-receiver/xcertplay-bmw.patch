diff --git a/common/src/main/java/com/shilapi/xcertplay/ActivityRetryOwner.kt b/common/src/main/java/com/shilapi/xcertplay/ActivityRetryOwner.kt
new file mode 100644
index 0000000..b0ad118
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/ActivityRetryOwner.kt
@@ -0,0 +1,38 @@
+package com.shilapi.xcertplay
+
+/** Main-thread ownership of one deferred restart, independent of the background session. */
+internal class ActivityRetryOwner(
+    private val post: (Runnable, Long) -> Unit,
+    private val remove: (Runnable) -> Unit,
+) {
+    private var pending: Runnable? = null
+    var isClosed = false
+        private set
+    val isPending: Boolean get() = pending != null
+
+    fun schedule(delayMillis: Long, restart: () -> Unit): Boolean {
+        if (isClosed || pending != null) return false
+        val task = object : Runnable {
+            override fun run() {
+                // Also reject a callback already dequeued before cancellation.
+                if (isClosed || pending !== this) return
+                pending = null
+                restart()
+            }
+        }
+        pending = task
+        post(task, delayMillis)
+        return true
+    }
+
+    fun cancel() {
+        val task = pending
+        pending = null
+        if (task != null) remove(task)
+    }
+
+    fun close() {
+        isClosed = true
+        cancel()
+    }
+}

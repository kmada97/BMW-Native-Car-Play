@@ -0,0 +1,55 @@
+package com.shilapi.xcertplay.bmw
+
+import android.content.Context
+import android.os.SystemClock
+import java.io.File
+import java.util.concurrent.ArrayBlockingQueue
+import java.util.concurrent.ThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import org.json.JSONObject
+
+/** Bounded stage-only trace: no phone identity, addresses, credentials, media or raw errors. */
+internal object BmwStartupTrace {
+    enum class Stage {
+        BOOT_RECEIVED, BOOT_SKIPPED, BOOT_LAUNCH,
+        HOME_CREATED, HOME_FOCUSED, HOME_LAUNCH,
+        CHECKPOINT_CREATED, CHECKPOINT_FOCUSED, RECEIVER_ARMED,
+        HOST_CREATED, HOST_PERMISSIONS_WAIT, CONFIGURED_DISPLAY_READY,
+        CONTROLLER_START, BACKGROUND_REUSED, AUTH_PREPARING, AUTH_READY,
+        HOTSPOT_STARTING, HOTSPOT_READY, PHONE_WAITING, BLUETOOTH_CONNECTING,
+        BLUETOOTH_CONTROL, NETWORK_ATTACHING, WIRELESS_ACTIVE,
+        AIRPLAY_SESSION_ACTIVE, VIDEO_STREAM_ACTIVE, START_FAILED,
+        RETRY_SCHEDULED, RESTART_BEGIN, RESTART_READY,
+    }
+    private val processStartMs = SystemClock.elapsedRealtime()
+    private val attempts = AtomicInteger()
+    private val writer = ThreadPoolExecutor(1, 1, 0, TimeUnit.MILLISECONDS,
+        ArrayBlockingQueue<Runnable>(64),
+        { task -> Thread(task, "bmw-startup-trace").apply { isDaemon = true } },
+        ThreadPoolExecutor.DiscardOldestPolicy())
+
+    fun nextAttempt(): Int = attempts.incrementAndGet()
+
+    fun mark(context: Context, stage: Stage, attempt: Int = 0, scheduledDelayMs: Long? = null) {
+        val elapsed = SystemClock.elapsedRealtime()
+        val uptime = SystemClock.uptimeMillis()
+        val directory = File(context.applicationContext.filesDir, "bmw-startup")
+        writer.execute {
+            runCatching {
+                directory.mkdirs()
+                val file = File(directory, "stages.jsonl")
+                if (file.length() >= 128 * 1024) {
+                    val previous = File(directory, "stages.previous.jsonl")
+                    previous.delete()
+                    if (!file.renameTo(previous)) file.delete()
+                }
+                val row = JSONObject().put("stage", stage.name).put("attempt", attempt)
+                    .put("boot_elapsed_ms", elapsed).put("uptime_ms", uptime)
+                    .put("process_elapsed_ms", elapsed - processStartMs)
+                scheduledDelayMs?.let { row.put("scheduled_delay_ms", it) }
+                file.appendText(row.toString() + "\n")
+            }
+        }
+    }
+}
diff --git a/common/src/main/java/com/shilapi/xcertplay/bmw/BmwTemplateLayout.java b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwTemplateLayout.java
new file mode 100644

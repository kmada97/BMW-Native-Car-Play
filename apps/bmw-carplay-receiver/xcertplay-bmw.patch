@@ -0,0 +1,100 @@
+package com.shilapi.xcertplay.media
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AudioDecodePumpTest {
+    @Test
+    fun decoderOutputIsDrainedBeforeInputIsRetried() {
+        val events = mutableListOf<String>()
+        var outputHeld = true
+        val pump = AudioDecodePump(object : AudioDecodePump.Port {
+            override fun drain() { events += "drain"; outputHeld = false }
+            override fun queue(bytes: ByteArray, presentationTimeUs: Long): Boolean {
+                events += "queue"
+                return !outputHeld
+            }
+        })
+        pump.submit(byteArrayOf(1), 42L)
+        pump.tick()
+        assertFalse(pump.hasPending)
+        assertEquals(listOf("drain", "queue", "drain"), events)
+    }
+
+    @Test
+    fun unavailableInputRetainsBytesAndTimestampUntilAccepted() {
+        val packet = byteArrayOf(7, 8, 9)
+        var available = false
+        var submitted = 0
+        var accepted = 0
+        val pump = AudioDecodePump(object : AudioDecodePump.Port {
+            override fun drain() = Unit
+            override fun queue(bytes: ByteArray, presentationTimeUs: Long): Boolean {
+                submitted++
+                assertArrayEquals(packet, bytes)
+                assertEquals(987654321L, presentationTimeUs)
+                if (available) accepted++
+                return available
+            }
+        })
+        pump.submit(packet, 987654321L)
+        repeat(3) { pump.tick(); assertTrue(pump.hasPending) }
+        available = true
+        pump.tick()
+        assertFalse(pump.hasPending)
+        pump.tick()
+        assertEquals(4, submitted)
+        assertEquals(1, accepted)
+    }
+
+    @Test
+    fun delayedOutputIsConsumedWithoutAnotherRtpPacket() {
+        var outputReady = false
+        var outputs = 0
+        var queues = 0
+        val pump = AudioDecodePump(object : AudioDecodePump.Port {
+            override fun drain() { if (outputReady) { outputs++; outputReady = false } }
+            override fun queue(bytes: ByteArray, presentationTimeUs: Long): Boolean {
+                queues++
+                return true
+            }
+        })
+        pump.submit(byteArrayOf(1), 12L)
+        pump.tick()
+        outputReady = true
+        pump.tick()
+        assertEquals(1, outputs)
+        assertEquals(1, queues)
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun backpressureCannotReplaceAnUnacceptedPacket() {
+        val pump = AudioDecodePump(object : AudioDecodePump.Port {
+            override fun drain() = Unit
+            override fun queue(bytes: ByteArray, presentationTimeUs: Long) = false
+        })
+        pump.submit(byteArrayOf(1), 1L)
+        pump.tick()
+        pump.submit(byteArrayOf(2), 2L)
+    }
+
+    @Test
+    fun multipleAcceptedPacketsPreserveOrderAndRtpTiming() {
+        val accepted = mutableListOf<Pair<Byte, Long>>()
+        val pump = AudioDecodePump(object : AudioDecodePump.Port {
+            override fun drain() = Unit
+            override fun queue(bytes: ByteArray, presentationTimeUs: Long): Boolean {
+                accepted += bytes.single() to presentationTimeUs
+                return true
+            }
+        })
+        for (index in 1..3) {
+            pump.submit(byteArrayOf(index.toByte()), index * 21333L)
+            pump.tick()
+        }
+        assertEquals(listOf(1.toByte() to 21333L, 2.toByte() to 42666L, 3.toByte() to 63999L), accepted)
+    }
+}

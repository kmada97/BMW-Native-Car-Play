+package com.shilapi.xcertplay.network
+
+import java.net.Inet6Address
+import java.net.InetAddress
+
+internal data class LocalOnlyHotspotInterface(
+    val name: String,
+    val hostAddress: InetAddress?,
+    val bssid: String?,
+)
+
+/** Called only after the manager selects the AP interface and scopes its address. */
+internal fun localOnlyHotspotInterface(
+    name: String,
+    hostAddress: InetAddress?,
+    hardwareAddress: ByteArray?,
+): LocalOnlyHotspotInterface? {
+    if (hostAddress == null) return null
+    val bssid = hardwareAddress?.toMacAddressString()
+        ?: (hostAddress as? Inet6Address)?.toEui64MacAddress()
+    // MAC visibility is optional. Never discard a usable IP solely because it is hidden.
+    return LocalOnlyHotspotInterface(name, hostAddress, bssid)
+}
+
+private fun ByteArray.toMacAddressString(): String =
+    joinToString(":") { "%02x".format(it.toInt() and 0xff) }
+
+private fun Inet6Address.toEui64MacAddress(): String? {
+    val bytes = address
+    if (!isLinkLocalAddress || bytes.size != 16 || bytes[11] != 0xff.toByte() ||
+        bytes[12] != 0xfe.toByte()
+    ) return null
+    return byteArrayOf(
+        (bytes[8].toInt() xor 0x02).toByte(), bytes[9], bytes[10], bytes[13], bytes[14], bytes[15],
+    ).toMacAddressString()
+}

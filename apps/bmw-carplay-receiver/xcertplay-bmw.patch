--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/bmw/LatestFrameSlotTest.kt
@@ -0,0 +1,37 @@
+package com.shilapi.xcertplay.bmw
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class LatestFrameSlotTest {
+    @Test fun newestFrameReplacesWithoutBacklog() {
+        val slot = LatestFrameSlot<Int>()
+        val token = slot.token()
+        repeat(1000) { assertTrue(slot.publish(token, it)) }
+        assertEquals(999, slot.latest())
+    }
+    @Test fun stopRejectsEncodingThatWasAlreadyInFlight() {
+        val slot = LatestFrameSlot<String>()
+        val old = slot.token()
+        slot.publish(old, "old")
+        val current = slot.reset()
+        assertNull(slot.latest())
+        assertFalse(slot.publish(old, "late result"))
+        assertTrue(slot.publish(current, "new session"))
+        assertEquals("new session", slot.latest())
+    }
+    @Test fun captureBoundsAndRotaryDeclaration() {
+        assertTrue(BmwVideoGeometry.valid(731, 480))
+        assertFalse(BmwVideoGeometry.valid(0, 480))
+        assertFalse(BmwVideoGeometry.valid(3840, 2160))
+        assertEquals(3, BmwVideoGeometry.KNOB_INPUT)
+    }
+    @Test fun unchangedJpegIsSuppressedExceptAfterResetOrResize() {
+        val gate=ChangedJpegGate()
+        assertTrue(gate.accept(1,731,480,byteArrayOf(1,2,3)))
+        assertFalse(gate.accept(1,731,480,byteArrayOf(1,2,3)))
+        assertTrue(gate.accept(1,731,480,byteArrayOf(1,2,4)))
+        assertTrue(gate.accept(2,731,480,byteArrayOf(1,2,4)))
+        assertTrue(gate.accept(2,640,480,byteArrayOf(1,2,4)))
+    }
+}

+package com.shilapi.xcertplay.media
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ReceiverHealthEventsTest {
+    @Test fun diagnosticFailureCannotInterruptAudioCaller() {
+        ReceiverHealthEvents.listener = { error("disk unavailable") }
+        try {
+            ReceiverHealthEvents.emit(ReceiverHealthEvents.Kind.AUDIO_RENDER, 100,
+                mapOf(ReceiverHealthEvents.Metric.UNDERRUNS to 0L))
+        } finally { ReceiverHealthEvents.listener = null }
+    }
+    @Test fun acceptedEventOwnsNumericSnapshotRatherThanMutableSource() {
+        var received: ReceiverHealthEvents.Event? = null
+        val values = mutableMapOf(ReceiverHealthEvents.Metric.UNDERRUNS to 1L)
+        ReceiverHealthEvents.listener = { received = it }
+        try {
+            ReceiverHealthEvents.emit(ReceiverHealthEvents.Kind.AUDIO_RENDER, 123, values)
+            values[ReceiverHealthEvents.Metric.UNDERRUNS] = 999
+            assertEquals(1L, received!!.metrics[ReceiverHealthEvents.Metric.UNDERRUNS])
+            assertEquals(123L, received!!.elapsedMs)
+        } finally { ReceiverHealthEvents.listener = null }
+    }
+}

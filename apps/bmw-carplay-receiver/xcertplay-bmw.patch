index 0000000..e05f587
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/bmw/BmwEglCapture.kt
@@ -0,0 +1,354 @@
+package com.shilapi.xcertplay.bmw
+
+import android.graphics.Bitmap
+import android.graphics.SurfaceTexture
+import android.opengl.EGL14
+import android.opengl.EGLConfig
+import android.opengl.EGLContext
+import android.opengl.EGLDisplay
+import android.opengl.EGLSurface
+import android.opengl.GLES11Ext
+import android.opengl.GLES20
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.SystemClock
+import android.view.Surface
+import java.io.ByteArrayOutputStream
+import java.io.Closeable
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * Owns the decoder Surface independently of Activity lifetime. One GL thread drains the latest
+ * decoded texture, draws optional preview, and samples with bounded interaction-aware pacing. JPEG has a separate worker
+ * with one replaceable pending bitmap; neither audio nor decoder callbacks do compression/RHMI.
+ */
+internal class BmwEglCapture(
+    private val videoWidth: Int,
+    private val videoHeight: Int,
+    private val policy: BmwCapturePolicy,
+    private val onSurface: (Surface) -> Unit,
+    private val onJpeg: (Int, Int, ByteArray, Long, Long) -> Unit,
+    private val onError: (String) -> Unit,
+) : Closeable {
+    private val thread = HandlerThread("bmw-decoded-capture").apply { start() }
+    private val handler = Handler(thread.looper)
+    private val closed = AtomicBoolean(false)
+    private val signalled = AtomicBoolean(false)
+    private val encoding = AtomicBoolean(false)
+    private val pending = AtomicReference<Sample?>(null)
+    private val changedJpeg = ChangedJpegGate()
+    // These three fields belong exclusively to the JPEG executor, including final recycling.
+    private val stillFrame = BmwStillFramePolicy()
+    private var lastPixels: Bitmap? = null
+    private var lastPixelsGeneration = Long.MIN_VALUE
+    private val encoder = Executors.newSingleThreadExecutor { r -> Thread(r, "bmw-jpeg") }
+    @Volatile private var target = Pair(BmwVideoGeometry.WIDTH, BmwVideoGeometry.HEIGHT)
+    @Volatile private var accepting = false
+    @Volatile private var generation = 0L
+    private var display: EGLDisplay = EGL14.EGL_NO_DISPLAY
+    private var context: EGLContext = EGL14.EGL_NO_CONTEXT
+    private var config: EGLConfig? = null
+    private var pbuffer: EGLSurface = EGL14.EGL_NO_SURFACE
+    private var preview: Surface? = null
+    private var previewEgl: EGLSurface = EGL14.EGL_NO_SURFACE
+    private var texture: SurfaceTexture? = null
+    private var inputSurface: Surface? = null
+    private var textureId = 0
+    private var program = 0
+    private var framebuffer = 0
+    private var colorTexture = 0
+    private var captureWidth = 0
+    private var captureHeight = 0
+    private val schedule = BmwCaptureSchedule()
+    private var pixels: ByteBuffer? = null
+    private val deferredCapture = Runnable { captureLatest() }
+    @Volatile private var refinementGeneration = Long.MIN_VALUE
+    private val refinementCapture = Runnable {
+        if (!closed.get() && accepting && generation == refinementGeneration && texture != null) {
+            // Re-sample the current texture, even if the decoder stopped sending a static UI.
+            // The JPEG worker checks exact pixels again before selecting refinement quality.
+            schedule.decoded();captureLatest()
+        }
+    }
+    private val matrix = FloatArray(16)
+    private val vertices = ByteBuffer.allocateDirect(16 * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply {
+        put(floatArrayOf(-1f,-1f,0f,0f, 1f,-1f,1f,0f, -1f,1f,0f,1f, 1f,1f,1f,1f)); position(0)
+    }
+    private data class Sample(val bitmap: Bitmap, val generation: Long, val capturedAtMs: Long, val quality: Int)
+
+    fun start() {
+        if(closed.get())return
+        handler.post {
+            if(closed.get())return@post
+            try {
+                initialize()
+                if(!closed.get())inputSurface?.let(onSurface)
+            } catch (e: Exception) { fail(e) }
+        }
+    }
+    fun setTargetSize(width: Int, height: Int) {
+        if (!BmwVideoGeometry.valid(width,height) || target == (width to height)) return
+        target = width to height
+        handler.post {
+            if (!closed.get() && accepting && texture != null) {
+                schedule.decoded(); captureLatest()
+            }
+        }
+    }
+    fun setActive(active: Boolean, generation: Long) {
+        this.generation = generation
+        accepting = active
+        if (!active) pending.getAndSet(null)?.bitmap?.recycle()
+        handler.post {
+            if (this.generation == generation) {
+                handler.removeCallbacks(deferredCapture)
+                handler.removeCallbacks(refinementCapture)
+                schedule.reset()
+            }
+        }
+    }
+    fun setPreview(surface: Surface?) {
+        if (closed.get()) return
+        handler.post {
+            if (closed.get() || preview === surface) return@post
+            destroyPreview()
+            preview = surface
+            // A released preview must never stop the headless capture route.
+            if (surface != null && surface.isValid && display != EGL14.EGL_NO_DISPLAY) {
+                previewEgl = EGL14.eglCreateWindowSurface(display, config, surface, intArrayOf(EGL14.EGL_NONE), 0)
+                if (previewEgl == EGL14.EGL_NO_SURFACE) { preview = null }
+            }
+        }
+    }
+    private fun initialize() {
+        display = EGL14.eglGetDisplay(EGL14.EGL_DEFAULT_DISPLAY)
+        check(display != EGL14.EGL_NO_DISPLAY && EGL14.eglInitialize(display, IntArray(2),0,IntArray(2),0)) { "EGL initialization failed" }
+        val configs = arrayOfNulls<EGLConfig>(1)
+        val count = IntArray(1)
+        val attrs = intArrayOf(EGL14.EGL_RED_SIZE,8,EGL14.EGL_GREEN_SIZE,8,EGL14.EGL_BLUE_SIZE,8,EGL14.EGL_ALPHA_SIZE,8,
+            EGL14.EGL_RENDERABLE_TYPE,EGL14.EGL_OPENGL_ES2_BIT,EGL14.EGL_SURFACE_TYPE,EGL14.EGL_WINDOW_BIT or EGL14.EGL_PBUFFER_BIT,EGL14.EGL_NONE)
+        check(EGL14.eglChooseConfig(display,attrs,0,configs,0,1,count,0) && count[0]>0) { "No EGL capture configuration" }
+        config = configs[0]
+        context = EGL14.eglCreateContext(display,config,EGL14.EGL_NO_CONTEXT,intArrayOf(EGL14.EGL_CONTEXT_CLIENT_VERSION,2,EGL14.EGL_NONE),0)
+        pbuffer = EGL14.eglCreatePbufferSurface(display,config,intArrayOf(EGL14.EGL_WIDTH,1,EGL14.EGL_HEIGHT,1,EGL14.EGL_NONE),0)
+        check(context != EGL14.EGL_NO_CONTEXT && pbuffer != EGL14.EGL_NO_SURFACE) { "EGL capture surface creation failed" }
+        makeCurrent(pbuffer)
+        program = linkProgram()
+        val ids=IntArray(1); GLES20.glGenTextures(1,ids,0);textureId=ids[0]
+        GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,textureId)
+        GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,GLES20.GL_TEXTURE_MIN_FILTER,GLES20.GL_LINEAR)
+        GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,GLES20.GL_TEXTURE_MAG_FILTER,GLES20.GL_LINEAR)
+        GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,GLES20.GL_TEXTURE_WRAP_S,GLES20.GL_CLAMP_TO_EDGE)
+        GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,GLES20.GL_TEXTURE_WRAP_T,GLES20.GL_CLAMP_TO_EDGE)
+        texture=SurfaceTexture(textureId).apply {
+            setDefaultBufferSize(videoWidth,videoHeight)
+            setOnFrameAvailableListener({
+                if (!closed.get() && signalled.compareAndSet(false,true)) handler.post(::drain)
+            }, handler)
+        }
+        inputSurface=Surface(texture)
+        // Preview may have arrived before EGL initialization; keep ownership on this GL thread.
+        preview?.takeIf { it.isValid }?.let {
+            previewEgl=EGL14.eglCreateWindowSurface(display,config,it,intArrayOf(EGL14.EGL_NONE),0)
+        }
+    }
+    private fun drain() {
+        signalled.set(false)
+        if (closed.get()) return
+        try {
+            makeCurrent(pbuffer)
+            texture?.updateTexImage()
+            texture?.getTransformMatrix(matrix)
+            if (previewEgl != EGL14.EGL_NO_SURFACE) {
+                try {
+                    if (preview?.isValid != true) throw IllegalStateException("Preview detached")
+                    makeCurrent(previewEgl)
+                    val w=IntArray(1);val h=IntArray(1)
+                    EGL14.eglQuerySurface(display,previewEgl,EGL14.EGL_WIDTH,w,0)
+                    EGL14.eglQuerySurface(display,previewEgl,EGL14.EGL_HEIGHT,h,0)
+                    GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER,0);draw(w[0],h[0])
+                    if(!EGL14.eglSwapBuffers(display,previewEgl)) throw IllegalStateException("Preview swap failed")
+                } catch (_: Exception) { destroyPreview() }
+            }
+            makeCurrent(pbuffer)
+            if (!accepting) return
+            schedule.decoded()
+            captureLatest()
+        } catch (e: Exception) { fail(e) }
+    }
+    private fun captureLatest() {
+        handler.removeCallbacks(deferredCapture)
+        if (closed.get() || !accepting) return
+        try {
+            val now=SystemClock.elapsedRealtime()
+            val delay=schedule.delayMs(now,policy.intervalMs(now)) ?: return
+            if (delay > 0) {
+                handler.postDelayed(deferredCapture,delay)
+                return
+            }
+            // Keep draining decoder textures, but do not read back/allocate another bitmap
+            // while the encoder already has one waiting. Dirty state preserves the final UI.
+            if (pending.get()!=null) {
+                handler.postDelayed(deferredCapture,20)
+                return
+            }
+            makeCurrent(pbuffer)
+            val captureGeneration=generation
+            val size=target;resizeFramebuffer(size.first,size.second)
+            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER,framebuffer);draw(size.first,size.second)
+            val requiredBytes=size.first*size.second*4
+            val buffer=pixels?.takeIf { it.capacity()==requiredBytes } ?: ByteBuffer.allocateDirect(requiredBytes)
+                .order(ByteOrder.nativeOrder()).also { pixels=it }
+            buffer.clear()
+            GLES20.glReadPixels(0,0,size.first,size.second,GLES20.GL_RGBA,GLES20.GL_UNSIGNED_BYTE,buffer)
+            check(GLES20.glGetError()==GLES20.GL_NO_ERROR) { "GL pixel capture failed" }
+            val bitmap=Bitmap.createBitmap(size.first,size.second,Bitmap.Config.ARGB_8888)
+            buffer.rewind();bitmap.copyPixelsFromBuffer(buffer)
+            schedule.captured(now)
+            pending.getAndSet(Sample(bitmap,captureGeneration,now,policy.jpegQuality(now)))?.bitmap?.recycle()
+            scheduleEncode()
+        } catch (e: Exception) { fail(e) }
+    }
+    private fun scheduleEncode() {
+        if (closed.get() || !encoding.compareAndSet(false,true)) return
+        try { encoder.execute {
+            try {
+                while (!closed.get()) {
+                    val sample=pending.getAndSet(null) ?: break
+                    var retained=false
+                    try {
+                        if (!accepting || generation!=sample.generation) continue
+                        if (lastPixelsGeneration != sample.generation) {
+                            lastPixels?.recycle();lastPixels=null
+                            lastPixelsGeneration=sample.generation;stillFrame.reset()
+                        }
+                        val pixelsChanged=lastPixels?.sameAs(sample.bitmap)!=true
+                        val pass=stillFrame.decide(pixelsChanged,SystemClock.elapsedRealtime(),policy.interactionUntilMs())
+                        if(pixelsChanged) {
+                            lastPixels?.recycle();lastPixels=sample.bitmap;retained=true
+                        }
+                        if(pass==BmwStillFramePolicy.Pass.NONE) {
+                            policy.duplicateSample()
+                            planRefinement(sample.generation)
+                            continue
+                        }
+                        val flip=android.graphics.Matrix().apply { setScale(1f,-1f) }
+                        val upright=Bitmap.createBitmap(sample.bitmap,0,0,sample.bitmap.width,sample.bitmap.height,flip,false)
+                        try {
+                            val bytes=ByteArrayOutputStream()
+                            val quality=if(pass==BmwStillFramePolicy.Pass.REFINE)BmwStillFramePolicy.REFINEMENT_QUALITY else sample.quality
+                            check(upright.compress(Bitmap.CompressFormat.JPEG,quality,bytes)) { "JPEG encode failed" }
+                            val jpeg=bytes.toByteArray()
+                            if(pass==BmwStillFramePolicy.Pass.REFINE)policy.refinementEncoded()
+                            if (accepting && generation==sample.generation && !closed.get() &&
+                                changedJpeg.accept(sample.generation,upright.width,upright.height,jpeg))
+                                onJpeg(upright.width,upright.height,jpeg,sample.generation,sample.capturedAtMs)
+                        } finally { if (upright !== sample.bitmap) upright.recycle() }
+                        planRefinement(sample.generation)
+                    } catch (e: Exception) { onError("JPEG capture: ${e.message}") }
+                    finally { if(!retained)sample.bitmap.recycle() }
+                }
+            } finally {
+                encoding.set(false)
+                if (pending.get()!=null && !closed.get()) scheduleEncode()
+            }
+        } } catch (_: java.util.concurrent.RejectedExecutionException) { encoding.set(false);pending.getAndSet(null)?.bitmap?.recycle() }
+    }
+    /** One replaceable timer; no bitmap crosses threads or enters a timer queue. */
+    private fun planRefinement(sampleGeneration:Long) {
+        handler.removeCallbacks(refinementCapture)
+        if(closed.get()||!accepting||generation!=sampleGeneration)return
+        val delay=stillFrame.nextDelayMs(SystemClock.elapsedRealtime(),policy.interactionUntilMs()) ?: return
+        refinementGeneration=sampleGeneration
+        handler.postDelayed(refinementCapture,delay)
+    }
+    private fun resizeFramebuffer(w:Int,h:Int) {
+        if(captureWidth==w&&captureHeight==h)return
+        if(framebuffer!=0)GLES20.glDeleteFramebuffers(1,intArrayOf(framebuffer),0)
+        if(colorTexture!=0)GLES20.glDeleteTextures(1,intArrayOf(colorTexture),0)
+        val ids=IntArray(1);GLES20.glGenTextures(1,ids,0);colorTexture=ids[0]
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D,colorTexture)
+        GLES20.glTexImage2D(GLES20.GL_TEXTURE_2D,0,GLES20.GL_RGBA,w,h,0,GLES20.GL_RGBA,GLES20.GL_UNSIGNED_BYTE,null)
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D,GLES20.GL_TEXTURE_MIN_FILTER,GLES20.GL_LINEAR)
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D,GLES20.GL_TEXTURE_MAG_FILTER,GLES20.GL_LINEAR)
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D,GLES20.GL_TEXTURE_WRAP_S,GLES20.GL_CLAMP_TO_EDGE)
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D,GLES20.GL_TEXTURE_WRAP_T,GLES20.GL_CLAMP_TO_EDGE)
+        GLES20.glGenFramebuffers(1,ids,0);framebuffer=ids[0]
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER,framebuffer)
+        GLES20.glFramebufferTexture2D(GLES20.GL_FRAMEBUFFER,GLES20.GL_COLOR_ATTACHMENT0,GLES20.GL_TEXTURE_2D,colorTexture,0)
+        check(GLES20.glCheckFramebufferStatus(GLES20.GL_FRAMEBUFFER)==GLES20.GL_FRAMEBUFFER_COMPLETE){"Incomplete capture framebuffer"}
+        captureWidth=w;captureHeight=h
+    }
+    private fun draw(w:Int,h:Int) {
+        GLES20.glViewport(0,0,w,h)
+        GLES20.glClearColor(0f,0f,0f,1f);GLES20.glClear(GLES20.GL_COLOR_BUFFER_BIT)
+        val scale=minOf(w.toDouble()/videoWidth,h.toDouble()/videoHeight)
+        val fitWidth=(videoWidth*scale).toInt().coerceAtLeast(1)
+        val fitHeight=(videoHeight*scale).toInt().coerceAtLeast(1)
+        GLES20.glViewport((w-fitWidth)/2,(h-fitHeight)/2,fitWidth,fitHeight)
+        GLES20.glUseProgram(program)
+        val position=GLES20.glGetAttribLocation(program,"aPosition");val uv=GLES20.glGetAttribLocation(program,"aUv")
+        vertices.position(0);GLES20.glVertexAttribPointer(position,2,GLES20.GL_FLOAT,false,16,vertices)
+        vertices.position(2);GLES20.glVertexAttribPointer(uv,2,GLES20.GL_FLOAT,false,16,vertices)
+        GLES20.glEnableVertexAttribArray(position);GLES20.glEnableVertexAttribArray(uv)
+        GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(program,"uTransform"),1,false,matrix,0)
+        GLES20.glActiveTexture(GLES20.GL_TEXTURE0);GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES,textureId)
+        GLES20.glUniform1i(GLES20.glGetUniformLocation(program,"uTexture"),0)
+        GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP,0,4)
+        GLES20.glDisableVertexAttribArray(position);GLES20.glDisableVertexAttribArray(uv)
+    }
+    private fun linkProgram():Int {
+        fun shader(type:Int,source:String):Int {
+            val shader=GLES20.glCreateShader(type);GLES20.glShaderSource(shader,source);GLES20.glCompileShader(shader)
+            val ok=IntArray(1);GLES20.glGetShaderiv(shader,GLES20.GL_COMPILE_STATUS,ok,0)
+            check(ok[0]!=0){GLES20.glGetShaderInfoLog(shader)};return shader
+        }
+        val vertex=shader(GLES20.GL_VERTEX_SHADER,"attribute vec2 aPosition; attribute vec2 aUv; uniform mat4 uTransform; varying vec2 vUv; void main(){gl_Position=vec4(aPosition,0.0,1.0);vUv=(uTransform*vec4(aUv,0.0,1.0)).xy;}")
+        val fragment=shader(GLES20.GL_FRAGMENT_SHADER,"#extension GL_OES_EGL_image_external : require\nprecision mediump float; varying vec2 vUv; uniform samplerExternalOES uTexture; void main(){gl_FragColor=texture2D(uTexture,vUv);}")
+        val p=GLES20.glCreateProgram();GLES20.glAttachShader(p,vertex);GLES20.glAttachShader(p,fragment);GLES20.glLinkProgram(p)
+        GLES20.glDeleteShader(vertex);GLES20.glDeleteShader(fragment)
+        val ok=IntArray(1);GLES20.glGetProgramiv(p,GLES20.GL_LINK_STATUS,ok,0);check(ok[0]!=0){GLES20.glGetProgramInfoLog(p)};return p
+    }
+    private fun makeCurrent(surface:EGLSurface) {check(EGL14.eglMakeCurrent(display,surface,surface,context)){"EGL makeCurrent failed"}}
+    private fun destroyPreview() {
+        if(previewEgl!=EGL14.EGL_NO_SURFACE) { EGL14.eglMakeCurrent(display,pbuffer,pbuffer,context);EGL14.eglDestroySurface(display,previewEgl) }
+        previewEgl=EGL14.EGL_NO_SURFACE;preview=null
+    }
+    private fun fail(error:Exception) {onError("Video capture unavailable: ${error.message}");close()}
+    override fun close() {
+        if(!closed.compareAndSet(false,true))return
+        accepting=false;pending.getAndSet(null)?.bitmap?.recycle()
+        // Queue disposal behind any encode already using lastPixels, never recycle it concurrently.
+        try { encoder.execute { lastPixels?.recycle();lastPixels=null;stillFrame.reset() } }
+        catch (_: java.util.concurrent.RejectedExecutionException) { /* Existing close owns disposal. */ }
+        encoder.shutdown()
+        handler.post {
+            try {
+                handler.removeCallbacks(deferredCapture)
+                handler.removeCallbacks(refinementCapture)
+                schedule.reset(); pixels=null
+                // Any GL drain already in flight has now finished publishing its last bitmap.
+                pending.getAndSet(null)?.bitmap?.recycle()
+                inputSurface?.release();texture?.setOnFrameAvailableListener(null);texture?.release()
+                if(display!=EGL14.EGL_NO_DISPLAY) {
+                    destroyPreview()
+                    if(context!=EGL14.EGL_NO_CONTEXT&&pbuffer!=EGL14.EGL_NO_SURFACE) {
+                        makeCurrent(pbuffer)
+                        if(program!=0)GLES20.glDeleteProgram(program)
+                        if(textureId!=0)GLES20.glDeleteTextures(1,intArrayOf(textureId),0)
+                        if(colorTexture!=0)GLES20.glDeleteTextures(1,intArrayOf(colorTexture),0)
+                        if(framebuffer!=0)GLES20.glDeleteFramebuffers(1,intArrayOf(framebuffer),0)
+                    }
+                    EGL14.eglMakeCurrent(display,EGL14.EGL_NO_SURFACE,EGL14.EGL_NO_SURFACE,EGL14.EGL_NO_CONTEXT)
+                    if(pbuffer!=EGL14.EGL_NO_SURFACE)EGL14.eglDestroySurface(display,pbuffer)
+                    if(context!=EGL14.EGL_NO_CONTEXT)EGL14.eglDestroyContext(display,context)
+                    EGL14.eglTerminate(display)
+                }
+            } finally { thread.quitSafely() }
+        }
+    }
+}

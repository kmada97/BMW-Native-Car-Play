+package com.shilapi.xcertplay.network
+
+import java.net.Inet6Address
+import java.net.InetAddress
+import org.junit.Assert.*
+import org.junit.Test
+
+class LocalOnlyHotspotInterfaceTest {
+    @Test fun privateIpv4RemainsUsableWhenAndroidHidesTheMac() {
+        val address = InetAddress.getByName("192.168.43.1")
+        val endpoint = localOnlyHotspotInterface("wlan0", address, null)
+        assertNotNull(endpoint)
+        assertEquals("wlan0", endpoint!!.name)
+        assertSame(address, endpoint.hostAddress)
+        assertNull(endpoint.bssid)
+    }
+
+    @Test fun randomLinkLocalIpv6RetainsItsInterfaceScopeWithoutAMac() {
+        val address = InetAddress.getByName("fe80::1234:5678:9abc:def0%7") as Inet6Address
+        val endpoint = localOnlyHotspotInterface("wlan0", address, null)
+        assertNotNull(endpoint)
+        assertSame(address, endpoint!!.hostAddress)
+        assertEquals(7, (endpoint.hostAddress as Inet6Address).scopeId)
+        assertNull(endpoint.bssid)
+    }
+
+    @Test fun observedMacStillTakesPrecedenceOverEui64Inference() {
+        val address = InetAddress.getByName("fe80::211:22ff:fe33:4455%7")
+        val endpoint = localOnlyHotspotInterface("wlan0", address, byteArrayOf(2, 3, 4, 5, 6, 7))
+        assertEquals("02:03:04:05:06:07", endpoint!!.bssid)
+    }
+
+    @Test fun eui64InferenceRemainsAvailableWhenHardwareMacIsHidden() {
+        val address = InetAddress.getByName("fe80::211:22ff:fe33:4455%7")
+        assertEquals("00:11:22:33:44:55", localOnlyHotspotInterface("wlan0", address, null)!!.bssid)
+    }
+
+    @Test fun macAloneCannotReplaceAMissingIpAddress() {
+        assertNull(localOnlyHotspotInterface("wlan0", null, byteArrayOf(2, 3, 4, 5, 6, 7)))
+    }
+}

@@ -0,0 +1,72 @@
+package com.shilapi.xcertplay.bmw
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import com.shilapi.xcertplay.AirPlayPersistence
+
+/** Optional Pi HOME target: Android starts a visible launcher without a background-launch grant. */
+class BmwHomeActivity : Activity() {
+    private val handler = Handler(Looper.getMainLooper())
+    private val launchGate = ForegroundLaunchGate()
+    private val launchReceiver = Runnable {
+        if (launchGate.consume()) openReceiver()
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        BmwStartupTrace.mark(this, BmwStartupTrace.Stage.HOME_CREATED)
+        requestReceiver()
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        setIntent(intent)
+        requestReceiver()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        launchGate.resume()
+        launchGate.focus(hasWindowFocus())
+        scheduleReceiver()
+    }
+
+    override fun onWindowFocusChanged(hasFocus: Boolean) {
+        super.onWindowFocusChanged(hasFocus)
+        launchGate.focus(hasFocus)
+        if (hasFocus) BmwStartupTrace.mark(this, BmwStartupTrace.Stage.HOME_FOCUSED)
+        if (hasFocus) scheduleReceiver() else handler.removeCallbacks(launchReceiver)
+    }
+
+    override fun onPause() {
+        launchGate.pause()
+        handler.removeCallbacks(launchReceiver)
+        super.onPause()
+    }
+
+    override fun onDestroy() {
+        launchGate.close()
+        handler.removeCallbacks(launchReceiver)
+        super.onDestroy()
+    }
+
+    private fun requestReceiver() { launchGate.request(); scheduleReceiver() }
+    private fun scheduleReceiver() {
+        handler.removeCallbacks(launchReceiver)
+        handler.post(launchReceiver)
+    }
+
+    private fun openReceiver() {
+        BmwStartupTrace.mark(this, BmwStartupTrace.Stage.HOME_LAUNCH)
+        val launch = Intent(this, BmwCheckpointActivity::class.java)
+            .addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+        // The checkpoint verifies authentication configuration before starting the receiver.
+        // Without configuration it stays on its setup screen; no synthetic session is started.
+        if (AirPlayPersistence.loadAutoStartOnBoot(this)) launch.putExtra("mode", "receiver")
+        startActivity(launch)
+        finish()
+    }
+}
